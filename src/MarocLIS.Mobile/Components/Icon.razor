@*
    The application's icons: stroke drawings on a 24-unit grid, inline (no icon font, no file to
    fetch), coloured by the text colour around them. Directional ones (back) are mirrored in Arabic
    by the flip-rtl class.
*@
<svg class="@CssClass" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "back":
            <path d="M15 5l-7 7 7 7" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 4v7h-7" />
            break;
        case "flask":
            <path d="M9 3h6" /><path d="M10 3v6.5L5.2 18a2 2 0 0 0 1.7 3h10.2a2 2 0 0 0 1.7-3L14 9.5V3" /><path d="M7.5 14h9" />
            break;
        case "lock":
            <rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;
        case "alert":
            <path d="M12 3l9 16H3z" /><path d="M12 10v4" /><path d="M12 17.5v.01" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.8 2.8L16 10" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><path d="M12 7.5v.01" />
            break;
        case "doc-check":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M9 15l2 2 4-4" />
            break;
        case "logout":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 17l-5-5 5-5" /><path d="M5 12h11" />
            break;
        case "offline":
            <path d="M3 3l18 18" /><path d="M8.5 16.5a5 5 0 0 1 7 0" /><path d="M5 12.9a10 10 0 0 1 5.2-2.7" /><path d="M14.5 10.4a10 10 0 0 1 4.5 2.5" /><path d="M2 8.8a15 15 0 0 1 4.3-2.6" /><path d="M10.7 5.1A15 15 0 0 1 22 8.8" /><path d="M12 20h.01" />
            break;
        case "comment":
            <path d="M5 5h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-4 3v-3H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" />
            break;
        case "phone":
            <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public double Stroke { get; set; } = 1.8;
    [Parameter] public string? Class { get; set; }

    private string CssClass => Name == "back" ? $"flip-rtl {Class}".Trim() : Class ?? "";
}
