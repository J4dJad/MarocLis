@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@using MarocLIS.Domain.Inventory
@inject WebTexts Texts

@*
    Opening an inventory, the workstation's InventoryCountDialog: its date — today or earlier — and
    what it covers: the whole stock, one place, or one category. Only the box the scope uses is
    offered; a refusal is said next to its box (InventoryCountScreenRules.Check).
*@
<Modal Name="count-editor" Title="@Texts["InventoryCount.New"]" Hint="@Texts["StocksUi.Dialog.InventoryCount"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        @{ var (location, category) = InventoryCountScreenRules.ScopeBoxes(_form.Scope); }
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Field.Date"]</span>
                <input class="input @Refused(InventoryCountScreenRules.DateField)" type="date" max="@Today.ToString("yyyy-MM-dd")"
                       data-field="@InventoryCountScreenRules.DateField" @bind="_form.CountDate" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@InventoryCountScreenRules.DateField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["InventoryCount.Scope"]</span>
                <select class="input" data-field="count-scope" @bind="_form.Scope">
                    @foreach (var value in Enum.GetValues<InventoryCountScope>())
                    {
                        <option value="@value">@Texts[$"InventoryCountScope.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["InventoryCountScope.StorageLocation"]</span>
                <input class="input @Refused(InventoryCountScreenRules.LocationField)" type="text" autocomplete="off" list="count-locations"
                       maxlength="@InventoryCountScreenRules.LocationMaxLength" disabled="@(!location)"
                       data-field="@InventoryCountScreenRules.LocationField" @bind="_form.StorageLocation" @bind:event="oninput" />
                <datalist id="count-locations">
                    @foreach (var place in Locations)
                    {
                        <option value="@place"></option>
                    }
                </datalist>
                <FieldMessage Refusal="Shown" Field="@InventoryCountScreenRules.LocationField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["InventoryCountScope.Category"]</span>
                <select class="input @Refused(InventoryCountScreenRules.CategoryField)" disabled="@(!category)" data-field="@InventoryCountScreenRules.CategoryField" @bind="_form.Category">
                    @foreach (var value in Enum.GetValues<StockItemKind>())
                    {
                        <option value="@value">@Texts[$"StockItemKind.{value}"]</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@InventoryCountScreenRules.CategoryField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Comment"]</span>
                <textarea class="input" rows="2" maxlength="@InventoryCountScreenRules.NotesMaxLength" data-field="count-notes"
                          @bind="_form.Notes" @bind:event="oninput"></textarea>
            </label>
            <p class="field-span-2 small muted">@Texts["InventoryCount.ScopeNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>The places the stock is kept in, offered as the place's box is typed.</summary>
    [Parameter] public IReadOnlyList<string> Locations { get; set; } = [];
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<CreateInventoryCountRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private InventoryCountForm _form = new();
    private FieldRefusal? _refusal;
    private bool _initialised, _checked;

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
        if (_initialised) return;
        _initialised = true;
        _form = InventoryCountScreenRules.NewCount(Today);
    }

    private Task SaveAsync()
    {
        _refusal = InventoryCountScreenRules.Check(_form, Today);
        _checked = true;
        return _refusal is null ? OnSave.InvokeAsync(InventoryCountScreenRules.ToRequest(_form)) : Task.CompletedTask;
    }
}
