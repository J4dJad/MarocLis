    /// <summary>
    /// A manufacturer recall recorded, and how many patient results were produced with the lot — the
    /// question a recall raises; the list says who, which is what the recall needs.
    /// </summary>
    private Task RecallAsync(string reference) =>
        RunAsync(async () =>
        {
            _prompt = Prompt.None;
            if (SelectedLot is not { } lot || string.IsNullOrWhiteSpace(reference)) return;
            var lotId = lot.ReagentLotId;
            var trimmed = reference.Trim();
            var (recalled, drafted) = await Scopes.RunAsync<InventoryService, (Result<int>, ReorderOutcome)>(async s =>
            {
                var r = await s.RecallLotAsync(lotId, trimmed);
                return (r, s.LastReorder);
            });
            if (recalled.IsFailure)
            {
                Say(Texts["Inventory.Recall"], Texts.Describe(recalled.Errors), true);
                return;
            }

            await LoadAsync(keepLot: lotId);
            _status = InventoryScreenRules.ReorderMessage(drafted, Texts.T) is { } reorder ? (reorder, "critical") : (Texts["Message.Saved"], "normal");

            if (recalled.Value == 0)
            {
                Say(Texts["Inventory.Recall"], Texts["Inventory.RecallNoResults"]);
                return;
            }

            var warning = Texts.T("Inventory.RecallAffectedResults", recalled.Value, lot.LotNumber);
            if (Context.User.Has(Permissions.Results.View)) await ShowRecallListCoreAsync(lot, warning);
            else Say(Texts["Inventory.Recall"], warning, true);
        });

