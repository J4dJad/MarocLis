    // ---- Plumbing ----------------------------------------------------------------------------------

    private static string Join(string first, string? second) => second is null ? first : $"{first}  ·  {second}";

    /// <summary>A refusal of the service kept in the delivery, next to the box it names when it names one.</summary>
    private void Refused(Result result)
    {
        var error = result.FirstError;
        if (InventoryScreenRules.FieldOf(error) is { } field)
        {
            _fieldRefusal = new FieldRefusal(field, error.ResourceKey, error.Args.FirstOrDefault()?.ToString());
            _dialogRefusal = null;
        }
        else
        {
            _fieldRefusal = null;
            _dialogRefusal = Texts.Describe(result.Errors);
        }
    }

    private void Open(Prompt prompt)
    {
        _dialogRefusal = null;
        _fieldRefusal = null;
        _prompt = prompt;
    }

    private async Task RunAsync(Func<Task> step)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await step();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "A stock operation failed.");
            _prompt = Prompt.None;
            _status = (Texts[WebFailures.KeyFor(ex)], "critical");
        }
        finally
        {
            _busy = false;
        }
    }

    private void Say(string title, string text, bool critical = false)
    {
        _message = new Message(title, text, critical);
        _prompt = Prompt.Message;
    }

    private void ClosePrompt()
    {
        _prompt = Prompt.None;
        _message = null;
        _dialogRefusal = null;
        _fieldRefusal = null;
        _alerts = null;
        _recallList = null;
        _comparison = null;
        _receiveItem = null;
        _verdict = null;
    }
}
