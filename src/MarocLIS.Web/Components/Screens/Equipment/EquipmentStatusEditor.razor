@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@using MarocLIS.Domain.Equipment
@inject WebTexts Texts

@*
    A change of status, the workstation's EquipmentStatusDialog: where the instrument stands, the new
    status — only the four the service applies — with a warning before a return to service (refused
    while a calibration is lapsed) or a decommissioning (final), and the reason, which goes in the
    audit trail. Refusals are said next to their box (EquipmentScreenRules.Check).
*@
<Modal Name="equipment-status" Title="@EquipmentScreenRules.Title("Equipment.ChangeStatus", Row, Texts.T)" Hint="@Texts["StocksUi.Dialog.EquipmentStatus"]" OnCancel="OnCancel">
    <ChildContent>
        <p class="strong" data-state="current-status">@EquipmentScreenRules.CurrentStatus(Row, Texts.T)</p>
        <div class="form-grid">
            <label class="field">
                <span class="field-label">@Texts["Equipment.NewStatus"]</span>
                <select class="input" data-field="status-new" @bind="_form.Status">
                    @foreach (var value in EquipmentScreenRules.StatusChoices)
                    {
                        <option value="@value">@Texts[EquipmentScreenRules.StatusKey(value)]</option>
                    }
                </select>
            </label>
            @if (EquipmentScreenRules.StatusNoticeKey(_form.Status) is { } notice)
            {
                <p class="small abnormal" data-state="status-notice">@Texts[notice]</p>
            }
            <label class="field">
                <span class="field-label">@Texts["Field.Reason"]</span>
                <textarea class="input @Refused(EquipmentScreenRules.ReasonField)" rows="3" maxlength="@EquipmentScreenRules.ReasonMaxLength"
                          data-field="@EquipmentScreenRules.ReasonField" @bind="_form.Reason" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@EquipmentScreenRules.ReasonField" />
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical prompt-text text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public EquipmentRow Row { get; set; } = default!;
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(EquipmentStatus Status, string Reason)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly EquipmentStatusForm _form = new();
    private FieldRefusal? _refusal;
    private bool _checked;

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    private Task SaveAsync()
    {
        var (refused, reason) = EquipmentScreenRules.Check(_form);
        _refusal = refused;
        _checked = true;
        return reason is not null ? OnSave.InvokeAsync((_form.Status, reason)) : Task.CompletedTask;
    }
}
