@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@using MarocLIS.Domain.Equipment
@inject WebTexts Texts

@*
    A contract, the workstation's InstrumentContractDialog: its reference and supplier, its kind and
    whether it is in force, when it starts and for how long, what is committed (tests or an amount of
    captive reagents, a year or over the term) and the penalty, the analyses counted, the preventive
    visits and the maximum intervention delay, the analysers it covers, its captive reagents with
    their contract price and cost per test, and its maintenance, training, exit and penalty terms.
    A supplier, analyser or item no longer active stays offered, marked, when the contract uses it.
    Refusals are said next to their box (InstrumentContractScreenRules.Check).
*@
<Modal Name="instrument-contract" Title="@Title" Hint="@Texts["StocksUi.Dialog.InstrumentContract"]" Large="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-4">
            <label class="field">
                <span class="field-label">@Texts["Contracts.Reference"]</span>
                <input class="input mono @Refused(InstrumentContractScreenRules.ReferenceField)" type="text" dir="ltr" autocomplete="off"
                       maxlength="@InstrumentContractScreenRules.ReferenceMaxLength" data-field="@InstrumentContractScreenRules.ReferenceField"
                       @bind="Form.Reference" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.ReferenceField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Inventory.Supplier"]</span>
                <select class="input @Refused(InstrumentContractScreenRules.SupplierField)" data-field="@InstrumentContractScreenRules.SupplierField"
                        value="@(Form.SupplierId?.ToString() ?? string.Empty)" @onchange="SupplierChanged">
                    <option value="">—</option>
                    @foreach (var supplier in Options.Suppliers)
                    {
                        <option value="@supplier.Id">@InstrumentContractScreenRules.Display(supplier, Texts.Language, Texts.T)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.SupplierField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.Kind"]</span>
                <select class="input" data-field="contract-kind" @bind="Form.Kind">
                    @foreach (var value in Enum.GetValues<InstrumentContractKind>())
                    {
                        <option value="@value">@Texts[$"InstrumentContractKind.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.Start"]</span>
                <input class="input" type="date" data-field="contract-start" @bind="Form.Start" @bind:format="yyyy-MM-dd" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.DurationMonths"]</span>
                <input class="input num @Refused(InstrumentContractScreenRules.DurationField)" type="number" min="@InstrumentContractScreenRules.DurationMin"
                       max="@InstrumentContractScreenRules.DurationMax" data-field="@InstrumentContractScreenRules.DurationField" @bind="Form.DurationMonths" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.DurationField" />
            </label>
            <label class="field field-check field-active">
                <input type="checkbox" data-field="contract-active" @bind="Form.IsActive" />
                <span>@Texts["Contracts.Active"]</span>
            </label>
            <span></span>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Contracts.Basis"]</span>
                <select class="input" data-field="contract-basis" @bind="Form.Basis">
                    @foreach (var value in Enum.GetValues<CommitmentBasis>())
                    {
                        <option value="@value">@Texts[$"CommitmentBasis.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts[ContractCommitment.CountsPurchases(Form.Basis) ? "Web.ContractCommittedAmount" : "Contracts.Committed"]</span>
                <input class="input mono num @Refused(InstrumentContractScreenRules.CommittedField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@TypedNumber.AmountMaxLength" disabled="@(Form.Basis == CommitmentBasis.None)"
                       data-field="@InstrumentContractScreenRules.CommittedField" @bind="Form.Committed" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.CommittedField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Web.ContractPenaltyAmount"]</span>
                <input class="input mono num @Refused(InstrumentContractScreenRules.PenaltyAmountField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@TypedNumber.AmountMaxLength" data-field="@InstrumentContractScreenRules.PenaltyAmountField" @bind="Form.PenaltyAmount" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.PenaltyAmountField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Contracts.CountedAnalyses"]</span>
                <input class="input mono" type="text" dir="ltr" autocomplete="off" maxlength="@InstrumentContractScreenRules.CodesMaxLength"
                       data-field="contract-codes" title="@Form.CountedAnalyses" @bind="Form.CountedAnalyses" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.PreventiveVisits"]</span>
                <input class="input mono num @Refused(InstrumentContractScreenRules.VisitsField)" type="text" inputmode="numeric" dir="ltr" autocomplete="off"
                       maxlength="@InstrumentContractScreenRules.IntegerMaxLength" data-field="@InstrumentContractScreenRules.VisitsField" @bind="Form.PreventiveVisits" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.VisitsField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.MaxDelayHours"]</span>
                <input class="input mono num @Refused(InstrumentContractScreenRules.MaxDelayField)" type="text" inputmode="numeric" dir="ltr" autocomplete="off"
                       maxlength="@InstrumentContractScreenRules.IntegerMaxLength" data-field="@InstrumentContractScreenRules.MaxDelayField" @bind="Form.MaxDelayHours" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.MaxDelayField" />
            </label>
        </div>

        <div class="quote-pick contract-pick">
            <div class="field">
                <span class="field-label">@Texts["Contracts.Instruments"]</span>
                <ul class="check-list quote-pick-list" data-field="contract-instruments">
                    @foreach (var instrument in Options.Instruments)
                    {
                        var id = instrument.Id;
                        var label = InstrumentContractScreenRules.Display(instrument, Texts.Language, Texts.T);
                        <li>
                            <label class="field-check">
                                <input type="checkbox" checked="@Form.InstrumentIds.Contains(id)" data-field="contract-instrument-@instrument.Code"
                                       @onchange="e => Toggle(id, e)" />
                                <span class="cell-wrap" title="@label">@label</span>
                            </label>
                        </li>
                    }
                </ul>
                @if (Options.Instruments.Count == 0)
                {
                    <p class="muted small" data-state="no-instrument">@Texts["Web.ContractNoInstrument"]</p>
                }
            </div>
            <div class="field">
                <span class="field-label">@Texts["Contracts.CaptiveReagents"]</span>
                <div class="table-scroll quote-pick-list @Refused(InstrumentContractScreenRules.ReagentsField)" data-field="@InstrumentContractScreenRules.ReagentsField">
                    <table class="grid" data-grid="contract-reagents">
                        <thead>
                            <tr>
                                <th>@Texts["Inventory.Item"]</th>
                                <th class="num">@Texts["Web.ContractPrice"]</th>
                                <th class="num">@Texts["Web.ContractCostPerTest"]</th>
                                <th class="cell-check"><span class="visually-hidden">@Texts["Action.Remove"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Form.Reagents.Count; i++)
                            {
                                var index = i;
                                var line = Form.Reagents[i];
                                var price = InstrumentContractScreenRules.ReagentField("price", i);
                                var cost = InstrumentContractScreenRules.ReagentField("cost", i);
                                <tr data-row="@i">
                                    <td>
                                        <select class="input" aria-label="@Texts["Inventory.Item"]" data-field="contract-item-@i"
                                                value="@(line.StockItemId?.ToString() ?? string.Empty)" @onchange="e => ItemChanged(index, e)">
                                            <option value="">—</option>
                                            @foreach (var item in Options.StockItems)
                                            {
                                                <option value="@item.Id">@InstrumentContractScreenRules.Display(item, Texts.Language, Texts.T)</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="num stock-count">
                                        <input class="input mono num @Refused(price)" type="text" inputmode="decimal" dir="ltr" autocomplete="off" aria-label="@Texts["Web.ContractPrice"]"
                                               maxlength="@TypedNumber.AmountMaxLength" data-field="@price" @bind="line.Price" @bind:event="oninput" />
                                        <FieldMessage Refusal="Shown" Field="@price" />
                                    </td>
                                    <td class="num stock-count">
                                        <input class="input mono num @Refused(cost)" type="text" inputmode="decimal" dir="ltr" autocomplete="off" aria-label="@Texts["Web.ContractCostPerTest"]"
                                               maxlength="@TypedNumber.AmountMaxLength" data-field="@cost" @bind="line.CostPerTest" @bind:event="oninput" />
                                        <FieldMessage Refusal="Shown" Field="@cost" />
                                    </td>
                                    <td class="cell-check">
                                        <button type="button" class="btn btn-icon" title="@Texts["Action.Remove"]" aria-label="@Texts["Action.Remove"]"
                                                data-action="contract-remove-@i" @onclick="() => Form.Reagents.RemoveAt(index)">
                                            <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Trash2" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <FieldMessage Refusal="Shown" Field="@InstrumentContractScreenRules.ReagentsField" />
                <div>
                    <ActionButton Key="Action.Add" Disabled="@(Options.StockItems.Count == 0)" OnClick="() => Form.Reagents.Add(new ContractReagentForm())" />
                </div>
            </div>
        </div>

        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Contracts.MaintenanceTerms"]</span>
                <textarea class="input" rows="2" maxlength="@InstrumentContractScreenRules.LongTermsMaxLength" data-field="contract-maintenance"
                          @bind="Form.MaintenanceTerms" @bind:event="oninput"></textarea>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.TrainingTerms"]</span>
                <textarea class="input" rows="2" maxlength="@InstrumentContractScreenRules.ShortTermsMaxLength" data-field="contract-training"
                          @bind="Form.TrainingTerms" @bind:event="oninput"></textarea>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.ExitConditions"]</span>
                <textarea class="input" rows="2" maxlength="@InstrumentContractScreenRules.LongTermsMaxLength" data-field="contract-exit"
                          @bind="Form.ExitConditions" @bind:event="oninput"></textarea>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Contracts.PenaltyTerms"]</span>
                <textarea class="input" rows="2" maxlength="@InstrumentContractScreenRules.LongTermsMaxLength" data-field="contract-penalty"
                          @bind="Form.PenaltyTerms" @bind:event="oninput"></textarea>
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Notes"]</span>
                <textarea class="input" rows="2" maxlength="@InstrumentContractScreenRules.ShortTermsMaxLength" data-field="contract-notes"
                          @bind="Form.Notes" @bind:event="oninput"></textarea>
            </label>
            <p class="field-span-2 small muted" data-state="contract-notice">@Texts["Contracts.EditorNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public InstrumentContractForm Form { get; set; } = new();
    [Parameter, EditorRequired] public ContractOptions Options { get; set; } = new([], [], []);
    /// <summary>The contract edited; none for a new one.</summary>
    [Parameter] public Guid? ContractId { get; set; }
    [Parameter] public string? Reference { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SaveInstrumentContractRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private FieldRefusal? _refusal;
    private bool _checked;

    private string Title => ContractId is null ? Texts["Contracts.New"] : $"{Texts["Action.Edit"]} — {Reference}";

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    private void SupplierChanged(ChangeEventArgs e) =>
        Form.SupplierId = Guid.TryParse(e.Value as string, out var id) ? id : null;

    private void ItemChanged(int index, ChangeEventArgs e) =>
        Form.Reagents[index].StockItemId = Guid.TryParse(e.Value as string, out var id) ? id : null;

    private void Toggle(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) Form.InstrumentIds.Add(id);
        else Form.InstrumentIds.Remove(id);
    }

    private Task SaveAsync()
    {
        var (refused, request) = InstrumentContractScreenRules.Check(Form, ContractId);
        _refusal = refused;
        _checked = true;
        return request is not null ? OnSave.InvokeAsync(request) : Task.CompletedTask;
    }
}
