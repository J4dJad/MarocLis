@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@using MarocLIS.Domain.Equipment
@inject WebTexts Texts

@*
    An intervention, the workstation's MaintenanceDialog: its nature (a repair after a breakdown by
    default), the downtime, its description in French — required — Arabic and English, since it goes
    in the equipment's file, the parts replaced, the external technician, and whether the check after
    the intervention passed. Unticked, the instrument is not returned to service: an operational one
    is taken out of it, and the non-conformity is offered. Refusals are said next to their box
    (EquipmentScreenRules.Check).
*@
<Modal Name="maintenance" Title="@EquipmentScreenRules.Title("Equipment.RecordMaintenance", Row, Texts.T)" Hint="@Texts["StocksUi.Dialog.Maintenance"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Equipment.MaintenanceKind"]</span>
                <select class="input" data-field="maintenance-kind" @bind="_form.Kind">
                    @foreach (var value in Enum.GetValues<MaintenanceKind>())
                    {
                        <option value="@value">@Texts[$"MaintenanceKind.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Equipment.DowntimeHours"]</span>
                <input class="input mono num @Refused(EquipmentScreenRules.DowntimeField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@TypedNumber.MeasureMaxLength" data-field="@EquipmentScreenRules.DowntimeField" @bind="_form.Downtime" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@EquipmentScreenRules.DowntimeField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.DescriptionFr"]</span>
                <textarea class="input @Refused(EquipmentScreenRules.DescriptionField)" rows="2" dir="ltr" maxlength="@EquipmentScreenRules.DescriptionMaxLength"
                          data-field="@EquipmentScreenRules.DescriptionField" @bind="_form.DescriptionFr" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@EquipmentScreenRules.DescriptionField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Field.DescriptionAr"]</span>
                <textarea class="input" rows="2" dir="rtl" maxlength="@EquipmentScreenRules.DescriptionMaxLength"
                          data-field="maintenance-description-ar" @bind="_form.DescriptionAr" @bind:event="oninput"></textarea>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Field.DescriptionEn"]</span>
                <textarea class="input" rows="2" dir="ltr" maxlength="@EquipmentScreenRules.DescriptionMaxLength"
                          data-field="maintenance-description-en" @bind="_form.DescriptionEn" @bind:event="oninput"></textarea>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Equipment.PartsReplaced"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@EquipmentScreenRules.PartsMaxLength"
                       data-field="maintenance-parts" title="@_form.PartsReplaced" @bind="_form.PartsReplaced" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Equipment.ExternalTechnician"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@EquipmentScreenRules.TechnicianMaxLength"
                       data-field="maintenance-technician" title="@_form.Technician" @bind="_form.Technician" @bind:event="oninput" />
            </label>
            <label class="field-check field-span-2 @(_form.PostCheckPassed ? null : "critical strong")">
                <input type="checkbox" data-field="maintenance-postcheck" @bind="_form.PostCheckPassed" />
                <span>@Texts["Equipment.PostCheckPassed"]</span>
            </label>
            <p class="field-span-2 small @(_form.PostCheckPassed ? "muted" : "critical")" data-state="postcheck-notice">@Texts["Equipment.PostCheckExplanation"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public EquipmentRow Row { get; set; } = default!;
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<MaintenanceEntry> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private MaintenanceForm _form = EquipmentScreenRules.NewMaintenance();
    private FieldRefusal? _refusal;
    private bool _checked;

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    private Task SaveAsync()
    {
        var (refused, entry) = EquipmentScreenRules.Check(_form);
        _refusal = refused;
        _checked = true;
        return entry is not null ? OnSave.InvokeAsync(entry) : Task.CompletedTask;
    }
}
