@using System.Globalization
@using MarocLIS.Application.HumanResources
@using MarocLIS.Application.Input
@inject WebTexts Texts

@*
    The year's état 9421 for Simpl-IR, the workstation's SimplIrDialog: the year (the one just
    ended), and the referential codes the application does not hold, offered again as typed last in
    this browser. The three codes are required.
*@
<Modal Name="payroll-simplir" Title="@Texts["Payroll.SimplIr"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Payroll.SimplIrYear"]</span>
                <input class="input mono input-narrow @Refused(PayrollScreenRules.YearField)" type="number" dir="ltr" min="@PayrollScreenRules.FirstYear" max="@PayrollScreenRules.LastYear"
                       data-field="@PayrollScreenRules.YearField" @bind="_year" />
                <FieldMessage Refusal="Shown" Field="@PayrollScreenRules.YearField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Payroll.SimplIrCommune"]</span>
                <input class="input mono @Refused(PayrollScreenRules.CommuneField)" type="text" dir="ltr" autocomplete="off"
                       data-field="@PayrollScreenRules.CommuneField" title="@_commune" @bind="_commune" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PayrollScreenRules.CommuneField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Payroll.SimplIrLowRateCode"]</span>
                <input class="input mono @Refused(PayrollScreenRules.LowRateField)" type="text" dir="ltr" autocomplete="off"
                       data-field="@PayrollScreenRules.LowRateField" title="@_low" @bind="_low" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PayrollScreenRules.LowRateField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Payroll.SimplIrHighRateCode"]</span>
                <input class="input mono @Refused(PayrollScreenRules.HighRateField)" type="text" dir="ltr" autocomplete="off"
                       data-field="@PayrollScreenRules.HighRateField" title="@_high" @bind="_high" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PayrollScreenRules.HighRateField" />
            </label>
            <p class="field-span-2 message is-info small text-full" data-state="simplir-notice">@Texts["Payroll.SimplIrNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Export" Glyph="ActionButton.IconOf(SimplIrKey)" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    private const string SimplIrKey = "Payroll.SimplIr";

    /// <summary>The year proposed (PayrollScreenRules.SimplIrYear).</summary>
    [Parameter] public int Year { get; set; }

    /// <summary>The codes typed last (PayrollScreenRules.Remembered).</summary>
    [Parameter, EditorRequired] public SimplIrCodes Remembered { get; set; } = null!;

    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(int Year, SimplIrCodes Codes)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int _year;
    private string? _commune, _low, _high;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized()
    {
        _year = Math.Clamp(Year, PayrollScreenRules.FirstYear, PayrollScreenRules.LastYear);
        (_commune, _low, _high) = (Remembered.Commune, Remembered.LowIncomeRateCode, Remembered.HighIncomeRateCode);
    }

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var codes = PayrollScreenRules.Codes(_commune, _low, _high);
        _checked = PayrollScreenRules.CheckSimplIr(_year, codes);
        return _checked is null ? OnSave.InvokeAsync((_year, codes)) : Task.CompletedTask;
    }
}
