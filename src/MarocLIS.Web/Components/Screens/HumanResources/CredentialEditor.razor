@using MarocLIS.Application.HumanResources
@using MarocLIS.Application.Input
@using MarocLIS.Domain.HumanResources
@inject WebTexts Texts
@inject IClock Clock

@*
    One document of a file, the workstation's CredentialEditorDialog: a diploma, a training, a
    vaccination, a medical visit and its fitness — never its diagnosis. The title is proposed by the
    kind without overwriting one typed; a refusal is said next to its box (CredentialRules.Check,
    then PersonnelService's own refusals).
*@
<Modal Name="credential" Title="@Title" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Credential.Kind"]</span>
                <select class="input" data-field="@CredentialRules.KindField" value="@_form.Kind" @onchange="KindChanged">
                    @foreach (var value in Enum.GetValues<CredentialKind>())
                    {
                        <option value="@value">@Texts[$"CredentialKind.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Credential.Fitness"]</span>
                <select class="input @Refused(CredentialRules.FitnessField)" data-field="@CredentialRules.FitnessField" disabled="@(!CredentialRules.AsksFitness(_form.Kind))"
                        @bind="_form.Fitness">
                    @foreach (var value in Enum.GetValues<MedicalFitness>())
                    {
                        <option value="@value">@Texts[$"MedicalFitness.{value}"]</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@CredentialRules.FitnessField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Credential.Title"]</span>
                <input class="input @Refused(CredentialRules.TitleField)" type="text" autocomplete="off" maxlength="@CredentialRules.TitleMaxLength"
                       data-field="@CredentialRules.TitleField" title="@_form.Title" @bind="_form.Title" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@CredentialRules.TitleField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Credential.Reference"]</span>
                <input class="input mono" type="text" dir="ltr" autocomplete="off" maxlength="@CredentialRules.ReferenceMaxLength"
                       data-field="@CredentialRules.ReferenceField" title="@_form.Reference" @bind="_form.Reference" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Credential.IssuedBy"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@CredentialRules.IssuedByMaxLength"
                       data-field="@CredentialRules.IssuedByField" title="@_form.IssuedBy" @bind="_form.IssuedBy" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Credential.ObtainedOn"]</span>
                <input class="input input-date" type="date" max="@Clock.Today.ToString("yyyy-MM-dd")" data-field="@CredentialRules.ObtainedField"
                       @bind="_form.ObtainedOn" @bind:format="yyyy-MM-dd" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Credential.ExpiresOn"]</span>
                <input class="input input-date @Refused(CredentialRules.ExpiresField)" type="date" data-field="@CredentialRules.ExpiresField"
                       @bind="_form.ExpiresOn" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@CredentialRules.ExpiresField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Notes"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@CredentialRules.NoteMaxLength"
                       data-field="@CredentialRules.NoteField" title="@_form.Note" @bind="_form.Note" @bind:event="oninput" />
            </label>
            <p class="field-span-2 small muted text-full" data-state="no-diagnosis">@Texts["Credential.NoDiagnosisNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    /// <summary>The document corrected; none for a new one.</summary>
    [Parameter] public CredentialRow? Existing { get; set; }

    /// <summary>Whose file: in the title, as at the workstation.</summary>
    [Parameter] public string? Employee { get; set; }

    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<CredentialRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private CredentialForm _form = new();
    private FieldRefusal? _refusal;

    private string Title
    {
        get
        {
            var title = Texts[CredentialRules.TitleKey(Existing is null)];
            var who = Existing?.Title ?? Employee;
            return who is { Length: > 0 } ? $"{title} — {who}" : title;
        }
    }

    private FieldRefusal? Shown => _refusal ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized() => _form = CredentialRules.FormFor(Existing, Clock.Today, Texts.T);

    private void KindChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<CredentialKind>(e.Value as string, out var kind)) return;
        _form.Kind = kind;
        CredentialRules.KindChanged(_form, Texts.T);
    }

    private async Task SaveAsync()
    {
        var (refused, request) = CredentialRules.Check(_form);
        _refusal = refused;
        if (refused is not null) return;
        await OnSave.InvokeAsync(request!);
    }
}
