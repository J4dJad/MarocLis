@using System.Globalization
@using MarocLIS.Application.HumanResources
@using MarocLIS.Application.Input
@using MarocLIS.Domain.HumanResources
@inject WebTexts Texts

@*
    The year's legal rates, the workstation's PayrollParametersDialog: the CNSS and AMO rates and
    ceiling, the professional expenses, the family deduction, the SMIG, the monthly hours, the
    transport exemption and the income-tax scale; the draft months of the year are computed again
    when they change. A rate that is no number, or negative, is refused beside its box.
*@
<Modal Name="payroll-settings" Title="@Texts["Payroll.Settings"]" Hint="@Parameters.Year.ToString(CultureInfo.InvariantCulture)" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-3">
            @for (var i = 0; i < PayrollScreenRules.RateFields.Count; i++)
            {
                var index = i;
                var field = PayrollScreenRules.RateFields[i];
                <label class="field">
                    <span class="field-label text-full">@Texts[field.Key]</span>
                    <input class="input mono num @Refused(field.Field)" type="text" inputmode="decimal" autocomplete="off" dir="ltr"
                           maxlength="@PayrollScreenRules.AmountMaxLength" data-field="@field.Field" value="@_typed[index]" @onchange="e => _typed[index] = e.Value as string" />
                    <FieldMessage Refusal="Shown" Field="@field.Field" />
                </label>
            }
            <label class="field field-span-all">
                <span class="field-label">@Texts["PayrollRate.Scale"]</span>
                <input class="input mono @Refused(PayrollScreenRules.ScaleField)" type="text" autocomplete="off" dir="ltr" maxlength="@PayrollScreenRules.ScaleMaxLength"
                       data-field="@PayrollScreenRules.ScaleField" title="@_scale" @bind="_scale" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PayrollScreenRules.ScaleField" />
            </label>
            <p class="field-span-all message is-info small text-full" data-state="rates-notice">@Texts["PayrollRate.Notice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public PayrollParameters Parameters { get; set; } = null!;
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }

    /// <summary>The rates read, in the order of PayrollScreenRules.RateFields, and the scale.</summary>
    [Parameter] public EventCallback<(decimal[] Values, string Scale)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string?[] _typed = [];
    private string? _scale;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized()
    {
        _typed = [.. PayrollScreenRules.RateFields.Select(f => (string?)PayrollScreenRules.Rate(f.Get(Parameters), Texts.Culture))];
        _scale = Parameters.IncomeTaxScale;
    }

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var (refused, values) = PayrollScreenRules.CheckRates(_typed, _scale);
        _checked = refused;
        return refused is null ? OnSave.InvokeAsync((values, _scale ?? string.Empty)) : Task.CompletedTask;
    }
}
