@using MarocLIS.Application.Abstractions
@using MarocLIS.Application.Instruments
@inject WebTexts Texts
@inject ILogger<FrameTestDialog> Logger

@*
    « Tester une trame », the workstation's InstrumentFrameTestDialog: a frame pasted, loaded from
    the log or written by the INTEGRA's simulator is read by the server's previewer — the same
    InstrumentInterfaceService.PreviewMessageAsync, with the protocol and format being tried — and
    every result says what the import would do with it. Nothing is stored and no analyser is
    reached. The lines, their outcome and the summary are InstrumentInterfaceScreenRules'.
*@
<Modal Name="frame-test" Title="@($"{Texts["Interface.TestFrame"].TrimEnd('…')} — {Subtitle}")" Hint="@Texts["AdminDialog.InstrumentFrameTestDialog"]" Large="true" OnCancel="OnClose">
    <ChildContent>
        <p class="small muted">@Texts["Interface.TestFrameHelp"]</p>
        <textarea class="input frame-input" rows="8" dir="ltr" spellcheck="false" data-field="frame" @bind="_frame" @bind:event="oninput"></textarea>
        <div class="list-tools">
            <ActionButton Key="Interface.TestFrameRun" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Play" Primary="true" Disabled="_busy" OnClick="RunAsync" />
            <ActionButton Key="Interface.TestFrameLoadLast" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Download" Disabled="_busy" OnClick="LoadLastAsync" />
            @if (Sample is not null)
            {
                <ActionButton Key="Interface.TestFrameSample" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Code" Disabled="_busy" OnClick="SampleAsync" />
            }
            @if (_summary is { } summary)
            {
                <span class="small strong @(summary.Ok ? "normal-ink" : "abnormal")" data-state="summary">@summary.Text</span>
            }
        </div>
        @if (_message is { Length: > 0 } message)
        {
            <p class="message is-warning small" role="alert" data-state="frame-message">@message</p>
        }
        <div class="table-scroll table-scroll-short">
            <table class="grid" data-grid="preview">
                <thead>
                    <tr>
                        <th>@Texts["Interface.TestFrameSpecimen"]</th>
                        <th>@Texts["Interface.TestFrameOrder"]</th>
                        <th>@Texts["Interface.TestFrameRawTest"]</th>
                        <th>@Texts["Interface.TestFrameCode"]</th>
                        <th>@Texts["Interface.TestFrameParameter"]</th>
                        <th>@Texts["Interface.TestFrameValue"]</th>
                        <th>@Texts["Interface.TestFrameStored"]</th>
                        <th>@Texts["Result.InstrumentFlags"]</th>
                        <th>@Texts["Interface.TestFrameType"]</th>
                        <th>@Texts["Interface.TestFrameOutcome"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _lines)
                    {
                        <tr data-row="@line.Code">
                            <td class="mono small" dir="ltr">@InstrumentInterfaceScreenRules.Specimen(line, Texts.T)</td>
                            <td class="small">@InstrumentInterfaceScreenRules.Order(line)</td>
                            <td class="mono small" dir="ltr">@line.RawTestId</td>
                            <td class="mono small" dir="ltr">@line.Code</td>
                            <td class="mono small">@InstrumentInterfaceScreenRules.Parameter(line, Parameters)</td>
                            <td class="mono small" dir="ltr">@InstrumentInterfaceScreenRules.Value(line)</td>
                            <td class="mono small" dir="ltr">@line.StoredValue</td>
                            <td class="small">@line.Flags</td>
                            <td class="mono small">@line.ResultType</td>
                            <td class="small strong @OutcomeClass(line)">@InstrumentInterfaceScreenRules.Outcome(line, Texts.T)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Close" OnClick="OnClose" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;

    /// <summary>The frame selected in the log, read at once: the usual question is why it did not import.</summary>
    [Parameter] public string? Initial { get; set; }

    /// <summary>Parameter codes by id, from the link's code table.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> Parameters { get; set; } = new Dictionary<Guid, string>();

    [Parameter, EditorRequired] public Func<string, Task<Result<MessagePreview>>> Preview { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Task<string?>> LoadLast { get; set; } = default!;

    /// <summary>A frame in the link's protocol from the simulator; null hides the button (only the INTEGRA has one).</summary>
    [Parameter] public Func<Task<string>>? Sample { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string _frame = string.Empty;
    private IReadOnlyList<PreviewLine> _lines = [];
    private (string Text, bool Ok)? _summary;
    private string? _message;
    private bool _busy, _initialised;

    protected override async Task OnParametersSetAsync()
    {
        if (_initialised) return;
        _initialised = true;

        _frame = InstrumentInterfaceScreenRules.Displayable(Initial, "\n");
        if (!string.IsNullOrWhiteSpace(Initial)) await RunAsync();
    }

    private static string OutcomeClass(PreviewLine line) => InstrumentInterfaceScreenRules.OutcomeTone(line) switch
    {
        InterfaceTone.Ok => "normal-ink",
        InterfaceTone.Muted => "muted",
        _ => "critical"
    };

    private async Task RunAsync()
    {
        _message = null;
        if (string.IsNullOrWhiteSpace(_frame))
        {
            _message = Texts["Interface_RawFrameEmpty"];
            return;
        }

        _busy = true;
        try
        {
            var preview = await Preview(_frame);
            if (preview.IsFailure)
            {
                _message = Texts.Describe(preview.Errors);
                return;
            }

            _lines = preview.Value.Lines;
            _summary = (InstrumentInterfaceScreenRules.Summary(preview.Value, Texts.T),
                        InstrumentInterfaceScreenRules.SummaryTone(preview.Value) == InterfaceTone.Ok);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Previewing an analyser frame failed.");
            _message = Texts["Message.UnexpectedError"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadLastAsync()
    {
        _message = null;
        var frame = await LoadLast();
        if (frame is null)
        {
            _message = Texts["Interface.TestFrameNoMessage"];
            return;
        }

        _frame = InstrumentInterfaceScreenRules.Displayable(frame, "\n");
    }

    private async Task SampleAsync()
    {
        if (Sample is null) return;
        _frame = InstrumentInterfaceScreenRules.Displayable(await Sample(), "\n");
        await RunAsync();
    }
}
