@using MarocLIS.Application.Input
@using MarocLIS.Application.Samples
@inject WebTexts Texts

@*
    Splitting an aliquot off a tube, the workstation's SampleAliquotDialog: its volume (optional, but
    one typed and unreadable is refused next to its box), what it is for — what the person holding
    the fraction later needs to know — and where it goes; no place keeps the parent tube's.
*@
<Modal Name="aliquot" Title="@SampleStorageScreenRules.AliquotTitle(Row, Texts.T)" Hint="@SampleStorageScreenRules.AliquotSubtitle(Row, Texts.T)" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <p class="muted small text-full">@Texts["Sample.AliquotNotice"]</p>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Sample.Volume"]</span>
                <input class="input mono num @Refused(SampleStorageScreenRules.VolumeField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@SampleStorageScreenRules.VolumeMaxLength" data-field="@SampleStorageScreenRules.VolumeField" @bind="_form.Volume" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@SampleStorageScreenRules.VolumeField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Sample.AliquotPurpose"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@SampleStorageScreenRules.PurposeMaxLength"
                       data-field="@SampleStorageScreenRules.PurposeField" @bind="_form.Purpose" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Sample.Storage"]</span>
                <select class="input @Refused(SampleStorageScreenRules.LocationField)" data-field="@SampleStorageScreenRules.LocationField" @bind="_form.Location">
                    @foreach (var choice in Choices)
                    {
                        <option value="@choice.Value">@choice.Display</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@SampleStorageScreenRules.LocationField" />
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public StoredSampleRow Row { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> Places { get; set; } = [];
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<AliquotRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly AliquotForm _form = new();
    private FieldRefusal? _refusal;
    private bool _initialised, _checked;

    /// <summary>The empty entry keeps the parent tube's place, the tube's own place listed even when no longer active.</summary>
    private IReadOnlyList<StoragePlaceChoice> Choices =>
        SampleStorageScreenRules.PlaceChoices(Places, Row.StorageLocation, Texts["Sample.StorageNotSpecified"],
                                              place => Texts.T("Sample.StorageOutOfList", place));

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
        if (_initialised) return;
        _initialised = true;
        // The parent tube's place selected, as the workstation's list opens.
        var choices = Choices;
        _form.Location = choices[Math.Max(0, SampleStorageScreenRules.SelectedIndex(choices, Row.StorageLocation))].Value;
    }

    private Task SaveAsync()
    {
        var (refused, request) = SampleStorageScreenRules.CheckAliquot(_form);
        _refusal = refused;
        _checked = true;
        return request is not null ? OnSave.InvokeAsync(request) : Task.CompletedTask;
    }
}
