@using MarocLIS.Application.Input
@using MarocLIS.Application.Samples
@inject WebTexts Texts
@inject IClock Clock

@*
    Shelving a tube, the workstation's SampleStorageDialog: the place, from the site's closed list
    (the tube's own place kept and marked when it is no longer in it), the position in it (rack and
    slot) and, ticked, the date it is kept until. The tube is named under the title so the shelf is
    typed against the right one. Refusals are said next to their box (SampleStorageScreenRules.CheckShelve).
*@
<Modal Name="shelve" Title="@SampleStorageScreenRules.ShelveTitle(Row, Texts.T)" Hint="@SampleStorageScreenRules.ShelveSubtitle(Row)" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Sample.Storage"]</span>
                <select class="input @Refused(SampleStorageScreenRules.LocationField)" data-field="@SampleStorageScreenRules.LocationField" @bind="_form.Location">
                    @foreach (var choice in Choices)
                    {
                        <option value="@choice.Value">@choice.Display</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@SampleStorageScreenRules.LocationField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Sample.StoragePosition"]</span>
                <input class="input mono" type="text" dir="ltr" autocomplete="off" maxlength="@SampleStorageScreenRules.PositionMaxLength"
                       data-field="@SampleStorageScreenRules.PositionField" @bind="_form.Position" @bind:event="oninput" />
            </label>
            <div class="field">
                <label class="field-check">
                    <input type="checkbox" data-field="storage-has-keep-until" @bind="_form.HasKeepUntil" />
                    <span>@Texts["Sample.KeepUntil"]</span>
                </label>
                <input class="input input-date @Refused(SampleStorageScreenRules.KeepUntilField)" type="date" disabled="@(!_form.HasKeepUntil)"
                       data-field="@SampleStorageScreenRules.KeepUntilField" @bind="_form.KeepUntil" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@SampleStorageScreenRules.KeepUntilField" />
            </div>
            <p class="muted small field-span-2 text-full">@Texts["Sample.KeepUntilNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public StoredSampleRow Row { get; set; } = default!;

    /// <summary>The site's active storage places.</summary>
    [Parameter] public IReadOnlyList<string> Places { get; set; } = [];
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<ShelveRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ShelveForm _form = new();
    private FieldRefusal? _refusal;
    private bool _initialised, _checked;

    private IReadOnlyList<StoragePlaceChoice> Choices =>
        SampleStorageScreenRules.PlaceChoices(Places, Row.StorageLocation, Texts["Sample.StorageChoose"],
                                              place => Texts.T("Sample.StorageOutOfList", place));

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
        if (_initialised) return;
        _initialised = true;
        _form = SampleStorageScreenRules.ShelveFormFor(Row, Clock.Today);
        // The list's own spelling of the tube's place, so the box shows it selected.
        var choices = Choices;
        _form.Location = choices[Math.Max(0, SampleStorageScreenRules.SelectedIndex(choices, _form.Location))].Value;
    }

    private Task SaveAsync()
    {
        var (refused, request) = SampleStorageScreenRules.CheckShelve(_form, Row, Places.Count, Clock.Today);
        _refusal = refused;
        _checked = true;
        return request is not null ? OnSave.InvokeAsync(request) : Task.CompletedTask;
    }
}
