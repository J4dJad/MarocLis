@using MarocLIS.Application.Input
@using MarocLIS.Application.Quality
@inject WebTexts Texts

@*
    Registering a round, the workstation's EqaRoundDialog: the scheme, the round, its date and its
    deadline, the analyser, and the analytes its samples cover — one participation per analyte.
    EqaScreenRules' form and check; a refusal, the screen's or the service's, is said next to its box.
*@
<Modal Name="eqa-round" Title="@Texts["Eqa.RegisterRound"]" Hint="@Texts["QualityHr.Hint.EqaRound"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Quality.Scheme"]</span>
                <input class="input @Refused(EqaScreenRules.SchemeField)" data-field="@EqaScreenRules.SchemeField" maxlength="@EqaScreenRules.SchemeMaxLength"
                       autocomplete="off" @bind="_form.Scheme" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@EqaScreenRules.SchemeField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Quality.Round"]</span>
                <input class="input mono @Refused(EqaScreenRules.RoundField)" dir="ltr" data-field="@EqaScreenRules.RoundField" maxlength="@EqaScreenRules.RoundMaxLength"
                       autocomplete="off" @bind="_form.Round" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@EqaScreenRules.RoundField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Eqa.RoundDate"]</span>
                <input class="input" type="date" data-field="round-date" @bind="_form.RoundDate" @bind:format="yyyy-MM-dd" />
            </label>
            <div class="field">
                <label class="field-check field-label">
                    <input type="checkbox" data-field="has-deadline" @bind="_form.HasDeadline" />
                    <span>@Texts["Eqa.Deadline"]</span>
                </label>
                <input class="input @Refused(EqaScreenRules.DeadlineField)" type="date" data-field="@EqaScreenRules.DeadlineField" disabled="@(!_form.HasDeadline)"
                       aria-label="@Texts["Eqa.Deadline"]" @bind="_form.Deadline" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@EqaScreenRules.DeadlineField" />
            </div>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Eqa.Instrument"]</span>
                <select class="input" data-field="instrument" @onchange="InstrumentChanged">
                    <option value="" selected="@(_form.InstrumentId is null)">—</option>
                    @foreach (var instrument in Instruments)
                    {
                        <option value="@instrument.Id" selected="@(instrument.Id == _form.InstrumentId)">@EqaScreenRules.Option(instrument, Texts.Language)</option>
                    }
                </select>
            </label>
            <fieldset class="field field-span-2 eqa-parameters @Refused(EqaScreenRules.ParametersField)" data-field="@EqaScreenRules.ParametersField">
                <legend class="field-label">@Texts["Eqa.Parameters"] — @_form.ParameterIds.Count</legend>
                <ul class="check-list eqa-check-list">
                    @foreach (var parameter in Parameters)
                    {
                        var id = parameter.Id;
                        <li>
                            <label class="field-check">
                                <input type="checkbox" data-parameter="@parameter.Code" checked="@_form.ParameterIds.Contains(id)"
                                       @onchange="e => Tick(id, e.Value is true)" />
                                <span class="cell-wrap">@EqaScreenRules.Option(parameter, Texts.Language)</span>
                            </label>
                        </li>
                    }
                </ul>
                <FieldMessage Refusal="Shown" Field="@EqaScreenRules.ParametersField" />
            </fieldset>
            <p class="field-span-2 small muted">@Texts["Eqa.RegisterNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter] public IReadOnlyList<EqaOption> Parameters { get; set; } = [];
    [Parameter] public IReadOnlyList<EqaOption> Instruments { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Refusal { get; set; }

    /// <summary>A refusal of the service that names a box.</summary>
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }

    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<RegisterEqaRoundRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private EqaRoundForm _form = new();
    private FieldRefusal? _refusal;
    private bool _initialised;

    private FieldRefusal? Shown => _refusal ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (_initialised) return;
        _initialised = true;
        _form = EqaScreenRules.NewRound(Today);
    }

    private void InstrumentChanged(ChangeEventArgs e) =>
        _form.InstrumentId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void Tick(Guid id, bool ticked)
    {
        EqaScreenRules.Toggle(_form, id, ticked);
        if (Shown?.Field == EqaScreenRules.ParametersField) _refusal = null;
    }

    private Task SaveAsync()
    {
        _refusal = EqaScreenRules.Check(_form);
        return _refusal is null ? OnSave.InvokeAsync(EqaScreenRules.ToRequest(_form)) : Task.CompletedTask;
    }
}
