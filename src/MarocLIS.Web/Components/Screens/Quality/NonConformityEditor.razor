@using MarocLIS.Application.Input
@using MarocLIS.Application.Quality
@using MarocLIS.Domain.Quality
@inject WebTexts Texts
@inject UserScopes Scopes
@inject ILogger<NonConformityEditor> Logger

@*
    Opening a non-conformity, the workstation's NonConformityDialog: what happened, how bad, where
    it was found, what was done at once, and whether it reached patients. The patient count is
    asked only when released results were affected. The form, its check and its request are
    NonConformityScreenRules'; a refusal is said next to its box.
*@
<Modal Name="nc-editor" Title="@Texts["NonConformity.OpenNew"]" Hint="@Texts["QualityHr.Hint.NonConformity"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["NonConformity.Category"]</span>
                <select class="input" data-field="category" @bind="_form.Category">
                    @foreach (var value in Enum.GetValues<NonConformityCategory>())
                    {
                        <option value="@value">@Texts[$"NcCategory.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["NonConformity.Severity"]</span>
                <select class="input" data-field="severity" @bind="_form.Severity">
                    @foreach (var value in Enum.GetValues<NonConformitySeverity>())
                    {
                        <option value="@value">@Texts[$"NcSeverity.{value}"]</option>
                    }
                </select>
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["NonConformity.DetectionSource"]</span>
                <select class="input" data-field="source" @bind="_form.Source">
                    @foreach (var value in Enum.GetValues<DetectionSource>())
                    {
                        <option value="@value">@Texts[$"DetectionSource.{value}"]</option>
                    }
                </select>
            </label>
            @* The tube the file is about — a refused or haemolysed tube is the commonest case —, found by
               its barcode or its file's number, as on the workstation. *@
            <div class="field field-span-2" data-state="@NonConformityScreenRules.SampleField">
                <span class="field-label">@Texts["NonConformity.Sample"]</span>
                <span class="input-with-button">
                    <input class="input mono" dir="ltr" type="text" autocomplete="off" data-field="sample-term"
                           maxlength="@NonConformityScreenRules.SampleTermMaxLength" placeholder="@Texts["NonConformity.SamplePlaceholder"]"
                           aria-label="@Texts["NonConformity.SamplePlaceholder"]"
                           @bind="_form.SampleTerm" @bind:event="oninput" @onkeydown="SampleKeyAsync" />
                    <ActionButton Key="Action.Search" Disabled="@(_searching || string.IsNullOrWhiteSpace(_form.SampleTerm))" OnClick="FindSamplesAsync" />
                </span>
                @if (_form.SampleChoices.Count > 0)
                {
                    <select class="input mono" dir="ltr" data-field="sample" aria-label="@Texts["NonConformity.Sample"]" @onchange="SampleChanged">
                        <option value="" selected="@(_form.SampleId is null)">@Texts["NonConformity.NoSample"]</option>
                        @foreach (var choice in _form.SampleChoices)
                        {
                            <option value="@choice.SampleId" selected="@(choice.SampleId == _form.SampleId)">@NonConformityScreenRules.SampleText(choice, Texts.Language, Texts.T)</option>
                        }
                    </select>
                }
                else if (NonConformityScreenRules.SampleSearchOutcome(_form, Texts.T) is { } notFound && _searched)
                {
                    <p class="small abnormal" data-state="sample-not-found">@notFound</p>
                }
            </div>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Description"]</span>
                <textarea class="input @(_refusal?.Field == NonConformityScreenRules.DescriptionField ? "is-refused" : null)" rows="3"
                          maxlength="@NonConformityScreenRules.TextMaxLength" data-field="@NonConformityScreenRules.DescriptionField"
                          @bind="_form.Description" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="_refusal" Field="@NonConformityScreenRules.DescriptionField" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["NonConformity.ImmediateAction"]</span>
                <textarea class="input" rows="2" maxlength="@NonConformityScreenRules.TextMaxLength" data-field="immediate"
                          @bind="_form.ImmediateAction" @bind:event="oninput"></textarea>
            </label>
            <label class="field-check strong critical">
                <input type="checkbox" data-field="affected" @bind="_form.AffectedResults" />
                <span>@Texts["NonConformity.AffectedResults"]</span>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Web.NcPatientCount"]</span>
                <input class="input mono num" type="number" min="0" max="@NonConformityScreenRules.PatientCountMax" data-field="patients"
                       disabled="@(!NonConformityScreenRules.PatientCountEnabled(_form))" @bind="_form.PatientCount" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["NonConformity.DueDate"]</span>
                <input class="input" type="date" data-field="due" @bind="_form.DueDate" @bind:format="yyyy-MM-dd" />
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>A file opened from another screen, filled with what that screen knows (a failed check after an intervention).</summary>
    [Parameter] public NonConformityForm? Prefilled { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<CreateNonConformityRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private NonConformityForm _form = new();
    private FieldRefusal? _refusal;
    private bool _initialised, _searching, _searched;

    protected override void OnParametersSet()
    {
        if (_initialised) return;
        _initialised = true;
        _form = Prefilled ?? NonConformityScreenRules.NewForm(Today);
    }

    private async Task SampleKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await FindSamplesAsync();
    }

    /// <summary>The tubes for what was typed: a barcode picks its tube, a file's number lists its tubes.</summary>
    private async Task FindSamplesAsync()
    {
        if (_searching || string.IsNullOrWhiteSpace(_form.SampleTerm)) return;
        _searching = true;
        try
        {
            var found = await Scopes.RunAsync<NonConformityService, Result<IReadOnlyList<NonConformitySampleChoice>>>(
                s => s.FindSamplesAsync(_form.SampleTerm));
            NonConformityScreenRules.SamplesFound(_form, found.IsSuccess ? found.Value : []);
            _searched = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Looking for the tube of a non-conformity failed.");
            NonConformityScreenRules.SamplesFound(_form, []);
        }
        finally
        {
            _searching = false;
        }
    }

    private void SampleChanged(ChangeEventArgs e) =>
        NonConformityScreenRules.PickSample(_form, Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private Task SaveAsync()
    {
        _refusal = NonConformityScreenRules.Check(_form);
        return _refusal is null ? OnSave.InvokeAsync(NonConformityScreenRules.ToRequest(_form)) : Task.CompletedTask;
    }
}
