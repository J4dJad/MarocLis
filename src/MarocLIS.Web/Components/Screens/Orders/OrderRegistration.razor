    /// <summary>Adds the files to the prescription being put together: assembled at once, so its pages show.</summary>
    private async Task AddPrescriptionPagesAsync(IReadOnlyList<PrescriptionPage> pages)
    {
        if (_preparingPrescription || !PrescriptionScanRules.CanAttachAtRegistration(User)) return;

        _preparingPrescription = true;
        StateHasChanged();
        try
        {
            var existing = _prescription.Content;
            var prepared = await Scopes.RunAsync<PrescriptionScanService, Result<PrescriptionScanFile>>(
                s => s.PrepareAsync(pages, existing));

            if (prepared.IsFailure)
            {
                _info = new Info("prescription", Texts["Order.PrescriptionScan"], [Texts.Describe(prepared.Errors)]);
                return;
            }

            _prescription.Keep(prepared.Value);
            Changed();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Prescription could not be assembled.");
            _info = new Info("failure", Texts["Order.PrescriptionScan"], [Texts[WebFailures.KeyFor(ex)]]);
        }
        finally
        {
            _preparingPrescription = false;
        }
    }

