    // ---- Quote and readiness -----------------------------------------------------------------------

    private void RequestQuote() => _ = RequestQuoteAsync();

    private async Task RequestQuoteAsync()
    {
        if (!await Debounce(Restart(ref _quoteDebounce), 250)) return;
        await RefreshQuoteAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Asks the registration's pricing for the request as it stands: the same resolution of the
    /// profiles, the same coverage and the same tariff the save will apply.
    /// </summary>
    private async Task RefreshQuoteAsync()
    {
        var version = ++_quoteVersion;

        if (_basket.IsEmpty)
        {
            _quote = null;
            return;
        }

        try
        {
            var request = new OrderQuoteRequest
            {
                PatientId = _patient?.Id,
                AnalysisTestIds = _basket.AnalysisTestIds,
                TestPanelIds = _basket.TestPanelIds,
                BillDirectlyToPatient = _selfPay
            };
            var quoted = await Scopes.RunAsync<IOrderQuotes, Result<OrderQuote>>(q => q.QuoteAsync(request));

            if (version != _quoteVersion) return;

            if (quoted.IsFailure)
            {
                _quote = null;
                Notice(Texts.Describe(quoted.Errors), "critical");
                return;
            }

            _quote = quoted.Value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pricing the request failed.");
        }
    }

    /// <summary>
    /// What the bar says next to the buttons: ready, what is missing, or what the save would refuse.
    /// A message from the last action stays until the next change.
    /// </summary>
    private (string Text, string Tone) Status
    {
        get
        {
            if (_notice is { } notice) return notice;

            var missing = OrderBasket.MissingKeys(_patient is not null, !_basket.IsEmpty, PrescriberMissing())
                                     .Select(k => Texts[k]).ToList();

            if (missing.Count > 0) return (Texts.T("OrderEntry.Missing", string.Join(", ", missing)), "muted");
            if (_quote?.Problems is { Count: > 0 } problems) return (Texts.Describe(problems), "critical");

            // The longest fast and a consent to collect.
            var reminders = new List<string> { Texts["OrderEntry.Ready"] };
            if (_basket.MaxFastingHours is > 0 and var hours) reminders.Add($"{Texts["Catalog.FastingRequired"]} {Texts.T("Catalog.HoursValue", hours)}");
            if (_basket.RequiresConsent) reminders.Add(Texts["Consent.Required"]);
            return (string.Join(" · ", reminders), "normal");
        }
    }

    private string StatusText => Status.Text;

    private string StatusClass => $"is-{Status.Tone}";

    /// <summary>The clerk changed something: the last action's message gives way to the readiness.</summary>
    private void Changed() => _notice = null;

    private void Notice(string text, string tone) => _notice = (text, tone);

    // ---- Registration ------------------------------------------------------------------------------

    private async Task RegisterAsync(bool printLabels)
    {
        if (_patient is not { } patient || _basket.IsEmpty || _busy) return;
        if (!User.Has(Permissions.Orders.Create)) return;

        var prescriber = ChosenPrescriber();
        var prescriberText = _prescriberText.Trim();

        if (OrderBasket.PrescriberMissing(prescriber is not null, prescriberText, _origin))
        {
            _info = new Info("warning", Texts["Order.Title"], [Texts["Order_PrescriberRequired"]]);
            return;
        }

        var request = new RegisterOrderRequest
        {
            PatientId = patient.Id,
            AnalysisTestIds = _basket.AnalysisTestIds,
            TestPanelIds = _basket.TestPanelIds,
            Priority = _priority,
            Origin = _origin,
            PrescriberId = prescriber?.Id,
            PrescriberFreeText = prescriber is null && prescriberText.Length > 0 ? prescriberText : null,
            ClinicalInformation = string.IsNullOrWhiteSpace(_clinical) ? null : _clinical.Trim(),
            PatientFasted = _fasting,
            BillDirectlyToPatient = _selfPay
        };
        request = _prescription.ApplyTo(request);

        _busy = true;
        try
        {
            var result = await Scopes.RunAsync<OrderRegistrationService, Result<RegisteredOrder>>(s => s.RegisterAsync(request));

            if (result.IsFailure)
            {
                _info = new Info("failure", Texts["Order.Title"], [Texts.Describe(result.Errors)]);
                return;
            }

            var registered = result.Value;
            ResetForm();

            // The browser cannot reach the counter's label printer: « Enregistrer » offers the labels
            // as the workstation's label PDF (« Étiquettes (PDF) » in the summary), to be printed on
            // the label printer at 100 %. « Enregistrer sans étiquettes » offers none, as at the
            // workstation: they are reprinted, with a reason, from the file.
            Notice(OrderRegistrationRules.RegisteredStatus(Texts.T, registered.AccessionNumber, registered.Labels.Count,
                                                           printLabels, labelsAsPdf: true), "normal");

            _info = new Info("registered", Texts["OrderEntry.RegisteredTitle"], PricingLines(registered, printLabels), registered.OrderId,
                             printLabels ? registered.Labels : null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Order registration failed.");
            _info = new Info("failure", Texts["Order.Title"], [Texts[WebFailures.KeyFor(ex)]]);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The authoritative breakdown from the pricing engine: the payer's share, the patient's share,
    /// and any excess over the national reference tariff stated separately.
    /// </summary>
    private List<string> PricingLines(RegisteredOrder registered, bool printLabels)
    {
        var language = Texts.Language;
        var lines = OrderRegistrationRules.PricingLines(Texts.T, registered.AccessionNumber, registered.Pricing,
                                                        amount => amount.Format(language, Texts.Culture));

        // Warnings are advisory (a non-fasting sample a clinician knowingly accepts): reported, the
        // registration stands.
        if (registered.Warnings.Count > 0)
        {
            lines.Add(string.Empty);
            lines.Add(Texts.Describe(registered.Warnings));
        }

        if (printLabels && registered.Labels.Count > 0)
        {
            lines.Add(string.Empty);
            lines.Add(Texts["OrderEntry.LabelsPdfHint"]);
        }

        return lines;
    }

