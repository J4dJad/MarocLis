        var ids = new List<string> { $"{Texts["Order.Title"]} {row.MedicalRecordNumber}" };
        if (row.Cin is { Length: > 0 }) ids.Add($"{Texts["Patient.Cin"]} {row.Cin}");
        if (row.MobilePhone is { Length: > 0 }) ids.Add($"{Texts["OrderEntry.PhoneShort"]} {row.MobilePhone}");
