    /// <summary>
    /// The editor may hand back an existing patient rather than a new one: its duplicate check lets
    /// the clerk recognise somebody already on file. Either way the order is raised against it.
    /// </summary>
    private async Task NewPatientSavedAsync(Guid id)
    {
        _newPatient = false;
        await SelectPatientAsync(id);
    }

    /// <summary>
    /// A provisional file, selected with the priority set to urgent: a patient who cannot be named
    /// is, by construction, an emergency.
    /// </summary>
    private async Task CreateProvisionalAsync((Gender Gender, int EstimatedAge) answer)
    {
        _provisional = false;

        try
        {
            var created = await Scopes.RunAsync<PatientRegistrationService, Result<Guid>>(
                s => s.RegisterProvisionalAsync(answer.Gender, answer.EstimatedAge));

            if (created.IsFailure)
            {
                _info = new Info("failure", Texts["Patient.Provisional"], [Texts.Describe(created.Errors)]);
                return;
            }

            await SelectPatientAsync(created.Value);
            _priority = OrderPriority.Urgent;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Opening a provisional file failed.");
            _info = new Info("failure", Texts["Patient.Provisional"], [Texts[WebFailures.KeyFor(ex)]]);
        }
    }

    private async Task SelectPatientAsync(Guid id)
    {
        try
        {
            var detail = await Scopes.RunAsync<IPatientQueries, PatientDetail?>(q => q.GetDetailAsync(id));
            if (detail is null) return;

            // Found again by its file number, so the band shows exactly what the search shows.
            var page = await Scopes.RunAsync<IPatientQueries, PagedResult<PatientSearchRow>>(
                q => q.SearchAsync(detail.MedicalRecordNumber, User.SiteId, pageSize: 10));
            if (page.Items.FirstOrDefault(p => p.Id == id) is not { } row) return;

            await PickPatientAsync(row);
            Notice($"{detail.MedicalRecordNumber} — {detail.LastName} {detail.FirstName}", "normal");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Selecting the patient failed.");
        }
    }

