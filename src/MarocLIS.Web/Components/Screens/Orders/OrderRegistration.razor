@using System.Globalization
@using MarocLIS.Application.Abstractions
@using MarocLIS.Application.Administration
@using MarocLIS.Application.Catalog
@using MarocLIS.Application.Orders
@using MarocLIS.Application.Patients
@using MarocLIS.Domain.Catalog
@using MarocLIS.Domain.Identity
@using MarocLIS.Domain.Orders
@using MarocLIS.Domain.Patients
@using MarocLIS.Infrastructure.Queries
@implements IDisposable
@inject WebTexts Texts
@inject SessionContext Context
@inject UserScopes Scopes
@inject IClock Clock
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<OrderRegistration> Logger
@inject IJSRuntime JS

@*
    « Nouvelle demande », the workstation's OrderRegistrationView: the patient, the request (priority,
    origin, prescriber, fasting, clinical information, direct payment), the catalogue and the basket
    with its tubes and the counter's total, then « Enregistrer ». Every rule is the application's:
    the basket (OrderBasket), the quote (IOrderQuotes, the pricing the save applies), the
    registration (OrderRegistrationService). The labels are printed by the Windows workstation: the
    browser has no access to the counter's label printer.
*@
<div class="screen order-entry" data-screen="orders">
    <div class="screen-body">
        <p class="page-lead">@Texts["OrderEntry.Subtitle"]</p>

        <section class="card patient-card" data-card="patient">
            @if (_patient is { } patient)
            {
                <div class="patient-band" data-state="patient" data-patient="@patient.MedicalRecordNumber">
                    <span class="initials @(patient.HasCriticalAlert ? "is-critical" : null)" aria-hidden="true">@OrderRegistrationRules.Initials(patient.FullName)</span>
                    <div class="patient-band-text">
                        <div class="patient-band-name @(patient.HasCriticalAlert ? "critical" : "accent")">@patient.FullName</div>
                        <div class="muted">@Facts(patient)</div>
                        <div class="muted small">@Ids(patient)</div>
                    </div>
                    <div class="patient-band-end">
                        <span class="small">
                            @History(patient)
                            @if (patient.OrderCount > 0 && User.Has(Permissions.Orders.View))
                            {
                                <button type="button" class="link" data-action="OrderEntry.View" @onclick="AskOpenLatestOrder">@Texts["OrderEntry.View"]</button>
                            }
                        </span>
                        <ActionButton Key="OrderEntry.ChangePatient" OnClick="ChangePatient" />
                    </div>
                </div>
            }
            else
            {
                <div class="toolbar">
                    <div class="search-box search-box-wide">
                        <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Search" />
                        <input class="input" type="search" placeholder="@Texts["OrderEntry.PatientSearchPlaceholder"]"
                               aria-label="@Texts["OrderEntry.PatientSearchPlaceholder"]" data-field="patient-search"
                               autocomplete="off" value="@_patientTerm" @oninput="PatientTermChanged" @onkeydown="PatientKey" />
                        @if (_patients.Count > 0)
                        {
                            <ul class="suggestions" role="listbox" data-list="patients">
                                @foreach (var row in _patients)
                                {
                                    <li role="option" class="@(row.HasCriticalAlert ? "is-critical" : null)" data-patient="@row.MedicalRecordNumber"
                                        @onclick="() => PickPatientAsync(row)">
                                        <span class="strong">@row.FullName</span>
                                        <span class="muted small">@row.MedicalRecordNumber · @Texts[$"Gender.{row.Gender}"]@(row.AgeYears is { } a ? $" · {a} {Texts["Report.Years"]}" : string.Empty)@(row.Cin is { Length: > 0 } ? $" · {row.Cin}" : string.Empty)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <ActionButton Key="Patient.NewFile" Disabled="@(!User.Has(Permissions.Patients.Create))" OnClick="() => _newPatient = true" />
                    <ActionButton Key="OrderEntry.UnidentifiedPatient" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.TriangleAlert"
                                  Disabled="@(!User.Has(Permissions.Patients.Create))" OnClick="() => _provisional = true" />
                </div>
            }
        </section>

        <section class="card request-card" data-card="request">
            <div class="form-grid form-grid-request">
                <label class="field"><span class="field-label">@Texts["Field.Priority"]</span>
                    <select class="input" data-field="priority" value="@_priority" @onchange="PriorityChanged">
                        @foreach (var p in Enum.GetValues<OrderPriority>())
                        {
                            <option value="@p" selected="@(p == _priority)">@Texts[$"Priority.{p}"]</option>
                        }
                    </select></label>
                <label class="field"><span class="field-label">@Texts["Order.Origin"]</span>
                    <select class="input" data-field="origin" value="@_origin" @onchange="OriginChanged">
                        @foreach (var o in Enum.GetValues<OrderOrigin>())
                        {
                            <option value="@o" selected="@(o == _origin)">@Texts[$"OrderOrigin.{o}"]</option>
                        }
                    </select></label>
                <div class="field field-prescriber">
                    <label class="field-label" for="order-prescriber">@PrescriberCaption</label>
                    <div class="input-with-button">
                        <input id="order-prescriber" class="input" list="order-prescribers" data-field="prescriber" autocomplete="off"
                               value="@_prescriberText" @oninput="PrescriberChanged" />
                        <ActionButton Key="Order.NewPrescriber" Text="" Title="@Texts["Order.NewPrescriber"]"
                                      Disabled="@(!(User.Has(Permissions.Catalog.Manage) || User.Has(Permissions.Orders.Create)))"
                                      OnClick="() => _newPrescriber = true" />
                    </div>
                    <datalist id="order-prescribers">
                        @foreach (var p in _prescribers)
                        {
                            <option value="@p.Display"></option>
                        }
                    </datalist>
                </div>
                <div class="field">
                    <span class="field-label">@Texts["Order.Fasted"]</span>
                    <div class="segmented" role="group" data-field="fasting">
                        @foreach (var (value, key) in FastingChoices)
                        {
                            <button type="button" class="btn @(value == _fasting ? "btn-primary" : "btn-secondary")" aria-pressed="@(value == _fasting ? "true" : "false")"
                                    data-fasting="@(value?.ToString() ?? "unknown")" @onclick="() => SetFasting(value)">@Texts[key]</button>
                        }
                    </div>
                </div>
                <label class="field field-clinical"><span class="field-label">@Texts["Order.ClinicalInformation"]</span>
                    <input class="input" data-field="clinical" maxlength="2000" placeholder="@Texts["OrderEntry.ClinicalPlaceholder"]"
                           value="@_clinical" @oninput="ClinicalChanged" /></label>
                <label class="field field-check field-self-pay">
                    <input type="checkbox" data-field="self-pay" checked="@_selfPay" @onchange="SelfPayChanged" />
                    <span>@Texts["OrderEntry.DirectPayment"]</span>
                </label>
            </div>
            @* The prescription, put together here and saved with the request: each file or photo a page. *@
            <div class="field field-prescription">
                <span class="field-label">@Texts["Order.PrescriptionScan"]</span>
                <PrescriptionAttachment Attached="_prescription.HasDocument" Pages="_prescription.PageCount" Appends="true"
                                        CanChange="@PrescriptionScanRules.CanAttachAtRegistration(User)" CanView="true"
                                        Busy="_preparingPrescription" OnPages="AddPrescriptionPagesAsync"
                                        OnRefused="PrescriptionRefused" OnView="ViewPrescriptionAsync"
                                        OnRemove="AskRemovePrescription" />
            </div>
        </section>

        <div class="split split-even">
            <section class="card catalog-card" data-card="catalogue">
                <div class="card-heading">
                    <h2 class="card-title">@Texts["Order.AddAnalyses"]</h2>
                    <span class="muted small">@Texts["OrderEntry.TypeHint"]</span>
                </div>
                <div class="search-box search-box-wide">
                    <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Search" />
                    <input class="input" type="search" placeholder="@Texts["Order.CatalogSearchPlaceholder"]"
                           aria-label="@Texts["Order.CatalogSearchPlaceholder"]" data-field="catalogue-search" autocomplete="off"
                           value="@_catalogTerm" @oninput="CatalogTermChanged" @onkeydown="CatalogKey" />
                    @if (Suggestions.Count > 0)
                    {
                        <ul class="suggestions" role="listbox" data-list="analyses">
                            @foreach (var item in Suggestions)
                            {
                                <li role="option" data-code="@item.Code" @onclick="() => AddFromSuggestion(item)">
                                    <span class="strong">@item.Name.For(Texts.Language)</span>
                                    <span class="muted small">@Subline(item)</span>
                                    <span class="num small">@Price(item.Price)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="chips" role="group">
                    <span class="chips-label">@Texts["OrderEntry.Catalogue"]</span>
                    @foreach (var (key, text) in FilterChips())
                    {
                        <button type="button" class="chip @(key == _filter ? "is-pressed" : null)" aria-pressed="@(key == _filter ? "true" : "false")"
                                data-filter="@key" @onclick="() => _filter = key">@text</button>
                    }
                </div>
                @if (_frequent.Count > 0)
                {
                    <div class="chips" role="group">
                        <span class="chips-label">@Texts["OrderEntry.FrequentPanels"]</span>
                        @foreach (var panel in _frequent)
                        {
                            <button type="button" class="chip" title="@panel.Code" data-panel="@panel.Code" @onclick="() => AddPanelAsync(panel.PanelId)">
                                @panel.Name.For(Texts.Language)
                            </button>
                        }
                    </div>
                }
                <div class="table-scroll">
                    <table class="grid grid-select" data-grid="catalogue">
                        <thead>
                            <tr>
                                <th>@Texts["Field.Code"]</th>
                                <th>@Texts["Field.Name"]</th>
                                <th>@Texts["Field.Department"]</th>
                                <th>@Texts["OrderEntry.Tube"]</th>
                                <th class="num">@Texts["OrderEntry.Delay"]</th>
                                <th class="num">@Texts["OrderEntry.PriceDh"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in OrderBasket.Filter(_catalogItems, _filter))
                            {
                                var state = _basket.StateOf(item);
                                <tr class="@(state != CatalogItemState.Free ? "is-pending" : null)" data-code="@item.Code" title="@Notes(item)"
                                    @ondblclick="() => AddItem(item)">
                                    <td class="mono">@item.Code</td>
                                    <td class="@(item.IsPanel ? "strong" : null)">@item.Name.For(Texts.Language)</td>
                                    <td>@(item.IsPanel ? "—" : item.DepartmentName?.For(Texts.Language) ?? string.Empty)</td>
                                    <td>@(item.IsPanel ? Texts["OrderEntry.SeveralTubes"] : item.ContainerName?.For(Texts.Language) ?? "—")</td>
                                    <td class="num">@Texts.T("Catalog.HoursValue", item.TurnaroundHours)</td>
                                    <td class="num">@Price(item.Price)</td>
                                    <td class="cell-action">
                                        @if (state == CatalogItemState.Free)
                                        {
                                            <button type="button" class="btn btn-secondary btn-small" title="@Texts["Action.Add"]" data-action="add"
                                                    @onclick="() => AddItem(item)"><Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Plus" /></button>
                                        }
                                        else
                                        {
                                            <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Check" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card basket-card" data-card="basket">
                <div class="card-heading">
                    <h2 class="card-title">@Texts["Order.Analyses"]
                        @if (!_basket.IsEmpty)
                        {
                            <span class="count-badge" data-state="basket-count">@_basket.Count</span>
                        }
                    </h2>
                    <ActionButton Key="OrderEntry.RemoveAll" Disabled="@_basket.IsEmpty" OnClick="AskRemoveAll" />
                </div>
                <table class="grid" data-grid="basket">
                    <thead>
                        <tr>
                            <th>@Texts["Catalog.Analysis"]</th>
                            <th>@Texts["OrderEntry.Tube"]</th>
                            <th class="num">@Texts["OrderEntry.PriceDh"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_basket.IsEmpty)
                        {
                            <tr><td colspan="4" class="muted">@Texts["App.NoData"]</td></tr>
                        }
                        @foreach (var item in _basket.Items)
                        {
                            var repeat = _basket.RepeatOf(item, _fullCatalog);
                            <tr class="@(repeat is not null ? "is-abnormal" : null)" data-code="@item.Code" title="@BasketNotes(item)">
                                <td>
                                    <div class="@(item.IsPanel ? "strong" : null)">@item.Name.For(Texts.Language)</div>
                                    <div class="muted small">@Subline(item)@(BasketNotes(item) is { Length: > 0 } notes ? $" · {notes}" : string.Empty)</div>
                                </td>
                                <td>@(item.IsPanel ? Texts["OrderEntry.SeveralTubes"] : item.ContainerName?.For(Texts.Language) ?? "—")</td>
                                <td class="num">@Price(item.Price)</td>
                                <td class="cell-action">
                                    <button type="button" class="btn btn-secondary btn-small" title="@Texts["Action.Remove"]" data-action="remove"
                                            @onclick="() => Remove(item)"><Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.X" /></button>
                                </td>
                            </tr>
                            @if (repeat is not null)
                            {
                                <tr class="is-abnormal basket-warning" data-warning="@item.Code">
                                    <td colspan="4">
                                        <span class="abnormal strong">@WarningText(repeat)</span>
                                        <button type="button" class="btn btn-secondary btn-small" data-action="keep" @onclick="() => Keep(item)">@Texts["OrderEntry.Keep"]</button>
                                        <button type="button" class="btn btn-secondary btn-small" data-action="remove-repeat" @onclick="() => Remove(item)">@Texts["Action.Remove"]</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="tubes" data-state="tubes">
                    <span class="strong">@Texts["OrderEntry.TubesToDraw"]</span>
                    @foreach (var tube in TubeGroups())
                    {
                        <span class="tube-chip"><span class="tube-swatch" style="background:@tube.Colour"></span>@tube.Text</span>
                    }
                    <span class="muted small">@Texts.T("OrderEntry.TubeCount", TubeCount, TubeCount * LabelCopies)</span>
                </div>

                <dl class="totals" data-state="totals">
                    <dt>@Texts.T("OrderEntry.GrossFor", _quote?.AnalysisCount ?? 0)</dt>
                    <dd class="num" data-total="gross">@((_quote?.Pricing.Total ?? Money.Zero).Format(Texts.Language, Texts.Culture))</dd>
                    @if (_quote?.PayerName is { } payer)
                    {
                        <dt>@Texts.T("OrderEntry.PayerShareOf", payer.For(Texts.Language))</dt>
                        <dd class="num" data-total="payer">− @((_quote.Pricing.Total - _quote.Pricing.DueAtCounter).Format(Texts.Language, Texts.Culture))</dd>
                    }
                    <dt class="strong">@Texts["OrderEntry.PatientRemainder"]</dt>
                    <dd class="num strong accent" data-total="due">@((_quote?.Pricing.DueAtCounter ?? Money.Zero).Format(Texts.Language, Texts.Culture))</dd>
                </dl>
            </section>
        </div>

    </div>

    <ActionBar StatusText="@StatusText" StatusClass="@StatusClass">
        <Secondary>
            <ActionButton Key="OrderEntry.SaveWithoutLabels" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Tag"
                          Disabled="@(!CanRegister || !User.Has(Permissions.Orders.Create))"
                          OnClick="() => RegisterAsync(OrderRegistrationRules.PrintsLabels(withoutLabels: true))" />
        </Secondary>
        <Destructive>
            <ActionButton Key="OrderEntry.CancelEntry" Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Eraser" Danger="true" OnClick="AskCancelEntry" />
        </Destructive>
        <Primary>
            <ActionButton Key="Action.Save" Primary="true"
                          Disabled="@(!CanRegister || !User.Has(Permissions.Orders.Create))"
                          OnClick="() => RegisterAsync(OrderRegistrationRules.PrintsLabels(withoutLabels: false))" />
        </Primary>
    </ActionBar>
</div>

@if (_newPatient)
{
    <MarocLIS.Web.Components.Screens.Patients.PatientEditor PatientId="null" OnSaved="NewPatientSavedAsync" OnCancel="() => _newPatient = false" />
}

@if (_provisional)
{
    <MarocLIS.Web.Components.Screens.Patients.ProvisionalPatientDialog OnCreate="CreateProvisionalAsync" OnCancel="() => _provisional = false" />
}

@if (_newPrescriber)
{
    <NewPrescriberDialog TypedName="@(ChosenPrescriber() is null ? _prescriberText : null)"
                         OnCreated="PrescriberCreatedAsync" OnCancel="() => _newPrescriber = false" />
}

@if (_confirm is { } confirm)
{
    <ConfirmPrompt Title="@confirm.Title" Message="@confirm.Message" OnYes="ConfirmedAsync" OnNo="() => _confirm = null" />
}

@if (_info is { } info)
{
    <Modal Name="@info.Name" Title="@info.Title" OnCancel="() => _info = null">
        <ChildContent>
            @foreach (var line in info.Lines)
            {
                @if (line.Length == 0)
                {
                    <div class="spacer"></div>
                }
                else
                {
                    <p class="info-line">@line</p>
                }
            }
        </ChildContent>
        <Footer>
            @if (info.Labels is { Count: > 0 } labels)
            {
                <LabelsPdfButton Source="MarocLIS.Web.Printing.NewLabels.Registration" Labels="labels" />
            }
            @if (info.OrderId is { } orderId && User.Has(Permissions.Orders.View))
            {
                <ActionButton Key="OrderEntry.View" OnClick="() => OpenOrder(orderId)" />
            }
            <ActionButton Key="Action.Ok" Primary="true" OnClick="() => _info = null" />
        </Footer>
    </Modal>
}

@code {
    /// <summary>
    /// A patient to choose when the screen opens: « Nouvelle demande pour ce patient » on the patient
    /// list, as <c>?patient=</c>.
    /// </summary>
    [Parameter] public Guid? PatientToSelect { get; set; }

    private sealed record PrescriberChoice(Guid Id, string Display);

    /// <summary>A message; after a registration, its number and the labels « Étiquettes (PDF) » downloads.</summary>
    private sealed record Info(string Name, string Title, IReadOnlyList<string> Lines, Guid? OrderId = null,
                               IReadOnlyList<SampleLabel>? Labels = null);

    private sealed record Confirmation(string Title, string Message, Func<Task> OnYes);

    private static readonly (bool? Value, string Key)[] FastingChoices =
        [(true, "Action.Yes"), (false, "Action.No"), (null, "OrderEntry.FastingUnknown")];

    private readonly OrderBasket _basket = new();
    private readonly List<CatalogPickerItem> _fullCatalog = [];
    private readonly List<CatalogPickerItem> _catalogItems = [];
    private IReadOnlyList<DepartmentOption> _departments = [];
    private IReadOnlyList<FrequentPanel> _frequent = [];
    private IReadOnlyList<PrescriberChoice> _prescribers = [];
    private IReadOnlyList<PatientSearchRow> _patients = [];

    private PatientSearchRow? _patient;
    private string _patientTerm = string.Empty;
    private string _catalogTerm = string.Empty;
    private string _filter = OrderBasket.FilterAll;

    private OrderPriority _priority = OrderPriority.Routine;
    private OrderOrigin _origin = OrderOrigin.Walkin;
    private string _prescriberText = string.Empty;
    private bool? _fasting = true;
    private string _clinical = string.Empty;
    private bool _selfPay;

    private OrderQuote? _quote;
    private (string Text, string Tone)? _notice;
    private bool _busy;
    private readonly PrescriptionDraft _prescription = new();
    private bool _preparingPrescription;

    private bool _newPatient;
    private bool _provisional;
    private bool _newPrescriber;
    private Confirmation? _confirm;
    private Info? _info;

    private CancellationTokenSource? _patientDebounce;
    private CancellationTokenSource? _catalogDebounce;
    private CancellationTokenSource? _quoteDebounce;
    private int _patientVersion;
    private int _catalogVersion;
    private int _quoteVersion;

    private ICurrentUser User => Context.User;

    private int LabelCopies => OrderBasket.LabelCopies(Configuration.GetValue("Labels:Copies", 1));

    private bool CanRegister => _patient is not null && !_basket.IsEmpty && !_busy;

    private string PrescriberCaption =>
        LabOrder.RequiresPrescriber(_origin) ? Texts["Order.Prescriber"] + " *" : Texts["Order.Prescriber"];

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogueReferenceAsync();
        await SearchCatalogueAsync();
        await LoadPrescribersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PatientToSelect is { } patientId)
        {
            // Used once, so coming back to the screen does not choose them again.
            PatientToSelect = null;
            await SelectPatientAsync(patientId);
        }
    }

    // ---- Reference data ----------------------------------------------------------------------------

    /// <summary>
    /// The whole catalogue once (for the profiles offered in one click and the sector filter), the
    /// sectors, and the profiles the site orders most.
    /// </summary>
    private async Task LoadCatalogueReferenceAsync()
    {
        try
        {
            var all = await Scopes.RunAsync<ICatalogQueries, IReadOnlyList<CatalogPickerItem>>(
                q => q.SearchPickerAsync(null, payerId: null, Clock.Today, take: 1000));
            _fullCatalog.Clear();
            _fullCatalog.AddRange(all);

            _departments = await Scopes.RunAsync<ICatalogQueries, IReadOnlyList<DepartmentOption>>(q => q.GetDepartmentsAsync());
            _frequent = await Scopes.RunAsync<IOrderEntryQueries, IReadOnlyList<FrequentPanel>>(
                q => q.GetFrequentPanelsAsync(User.SiteId, Clock.Now.AddDays(-180), take: 5));
        }
        catch (Exception ex)
        {
            // Only the shortcuts are lost; the search still finds every analysis.
            Logger.LogWarning(ex, "Loading the catalogue shortcuts failed.");
        }
    }

    private async Task LoadPrescribersAsync()
    {
        try
        {
            var rows = await Scopes.RunAsync<IMasterDataQueries, IReadOnlyList<PrescriberRow>>(
                q => q.GetPrescribersAsync(null, includeInactive: false));

            _prescribers =
            [
                .. rows.Select(p =>
                {
                    var speciality = p.Speciality?.For(Texts.Language);
                    return new PrescriberChoice(p.PrescriberId,
                        string.IsNullOrWhiteSpace(speciality) ? p.FullName : $"{p.FullName} — {speciality}");
                })
            ];
        }
        catch (Exception ex)
        {
            // The list only helps typing; a name typed freely is still accepted without it.
            Logger.LogWarning(ex, "Loading the prescribers failed.");
        }
    }

    private IEnumerable<(string Key, string Text)> FilterChips()
    {
        yield return (OrderBasket.FilterAll, Texts["OrderEntry.All"]);
        yield return (OrderBasket.FilterPanels, Texts["Catalog.Panels"]);

        // Only the sectors the catalogue actually has analyses in.
        var used = _fullCatalog.Select(i => i.DepartmentCode).OfType<string>().ToHashSet(StringComparer.Ordinal);
        foreach (var department in _departments.Where(d => used.Contains(d.Code)))
            yield return (department.Code, department.Name.For(Texts.Language));
    }

    // ---- Patient -----------------------------------------------------------------------------------

    private async Task PatientTermChanged(ChangeEventArgs e)
    {
        _patientTerm = e.Value?.ToString() ?? string.Empty;
        if (!await Debounce(Restart(ref _patientDebounce), 300)) return;
        await SearchPatientsAsync(showAll: false);
    }

    private async Task PatientKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _patients.Count == 0:
                await SearchPatientsAsync(showAll: true);
                break;
            case "Enter" when _patients.Count > 0:
                await PickPatientAsync(_patients[0]);
                break;
            case "Escape":
                _patients = [];
                break;
        }
    }

    private async Task SearchPatientsAsync(bool showAll)
    {
        var term = _patientTerm.Trim();
        var version = ++_patientVersion;

        // One or two characters match too much to be useful. An empty box lists the patients only
        // when asked (the down arrow), so nobody is chosen until the clerk picks one.
        if (term.Length is > 0 and < 3 || (term.Length == 0 && !showAll))
        {
            _patients = [];
            return;
        }

        try
        {
            var page = await Scopes.RunAsync<IPatientQueries, PagedResult<PatientSearchRow>>(
                q => q.SearchAsync(term, User.SiteId, pageSize: term.Length == 0 ? 100 : 25));
            if (version != _patientVersion) return;
            _patients = [.. page.Items.Take(8)];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Patient lookup failed during registration.");
        }
    }

    private async Task PickPatientAsync(PatientSearchRow row)
    {
        _patients = [];
        _patientTerm = string.Empty;

        _basket.ForgetPatient();
        _patient = row;
        Changed();
        RequestQuote();

        // A critical patient alert is stated before the clerk starts composing the order.
        if (row.HasCriticalAlert) _info = new Info("alerts", Texts["Patient.Title"], [Texts["Patient.Alerts"]]);

        await LoadRecentAnalysesAsync(row.Id);
    }

    private string Facts(PatientSearchRow row)
    {
        var facts = new List<string> { Texts[$"Gender.{row.Gender}"] };
        if (row.AgeYears is { } age) facts.Add($"{age} {Texts["Report.Years"]}");
        if (row.DateOfBirth is { } born)
            facts.Add(Texts.T("OrderEntry.BornOn", born.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)));
        return string.Join(" · ", facts);
    }

    private string Ids(PatientSearchRow row)
