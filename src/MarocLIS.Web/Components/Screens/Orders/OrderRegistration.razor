    // ---- Catalogue ---------------------------------------------------------------------------------

    private IReadOnlyList<CatalogPickerItem> Suggestions =>
        _catalogTerm.Trim().Length == 0 ? [] : [.. OrderRegistrationRules.Ranked(_catalogItems, _catalogTerm.Trim()).Take(6)];

    private async Task CatalogTermChanged(ChangeEventArgs e)
    {
        _catalogTerm = e.Value?.ToString() ?? string.Empty;
        if (!await Debounce(Restart(ref _catalogDebounce), 200)) return;
        await SearchCatalogueAsync();
    }

    private async Task CatalogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _catalogTerm = string.Empty; await SearchCatalogueAsync(); return; }
        if (e.Key != "Enter") return;

        var term = _catalogTerm.Trim();
        if (term.Length == 0) return;

        // Enter can arrive before the search started by the last keystroke has answered.
        _catalogDebounce?.Cancel();
        await SearchCatalogueAsync();

        if (OrderRegistrationRules.BestMatch(_catalogItems, term) is not { } match)
        {
            Notice(Texts["App.NoData"], "abnormal");
            return;
        }

        await AddAndClearAsync(match);
    }

    private Task AddFromSuggestion(CatalogPickerItem item) => AddAndClearAsync(item);

    // Cleared only when the analysis went in, so a refusal ("already in the panel") leaves the text
    // for the clerk to correct.
    private async Task AddAndClearAsync(CatalogPickerItem item)
    {
        AddItem(item);
        if (!_basket.Contains(item)) return;
        _catalogTerm = string.Empty;
        await SearchCatalogueAsync();
    }

    private async Task SearchCatalogueAsync()
    {
        var version = ++_catalogVersion;
        var term = _catalogTerm;

        try
        {
            IReadOnlyList<CatalogPickerItem> items = string.IsNullOrWhiteSpace(term) && _fullCatalog.Count > 0
                ? _fullCatalog
                : await Scopes.RunAsync<ICatalogQueries, IReadOnlyList<CatalogPickerItem>>(
                    q => q.SearchPickerAsync(term, payerId: null, Clock.Today));

            // Each keystroke starts a search; only the latest one may fill the list.
            if (version != _catalogVersion) return;

            _catalogItems.Clear();
            _catalogItems.AddRange(items);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading the catalogue picker failed.");
        }
    }

    private async Task AddPanelAsync(Guid panelId)
    {
        var item = _fullCatalog.FirstOrDefault(i => i.IsPanel && i.Id == panelId);

        if (item is null && _frequent.FirstOrDefault(f => f.PanelId == panelId)?.Code is { } code)
        {
            var found = await Scopes.RunAsync<ICatalogQueries, IReadOnlyList<CatalogPickerItem>>(
                q => q.SearchPickerAsync(code, payerId: null, Clock.Today));
            item = found.FirstOrDefault(i => i.IsPanel && i.Id == panelId);
        }

        if (item is not null) AddItem(item);
    }

    private void AddItem(CatalogPickerItem item)
    {
        _notice = null;

        // The basket's rules: an analysis once, a profile taking out its own members chosen alone.
        var added = _basket.Add(item);

        switch (added.Outcome)
        {
            case BasketAddOutcome.AlreadyPresent:
                Notice(Texts["Order_AnalysisAlreadyPresent"], "abnormal");
                return;

            case BasketAddOutcome.AlreadyInPanel:
                Notice(Texts.T("Order.AlreadyInPanel", item.Code, added.CoveringPanel!.Name.For(Texts.Language)), "abnormal");
                return;

            case BasketAddOutcome.MergedIntoPanel:
                Notice(Texts.T("Order.MergedIntoPanel", string.Join(", ", added.Absorbed!.Select(a => a.Code)),
                               item.Name.For(Texts.Language)), "abnormal");
                break;
        }

        RequestQuote();
    }

    private string Notes(CatalogPickerItem item)
    {
        var notes = new List<string>();
        if (item.IsPanel) notes.Add(Texts.T("ResultEntry.AnalysisMany", item.ComponentCount));
        if (item.FastingHours is { } fasting) notes.Add($"{Texts["Order.Fasted"]} {Texts.T("Catalog.HoursValue", fasting)}");
        if (item.ConsentRequirement != ConsentRequirement.None) notes.Add(Texts["Consent.Required"]);
        if (item.IsSubcontracted) notes.Add(Texts["Catalog.Subcontracted"]);
        return string.Join(" · ", notes);
    }

    private string Subline(CatalogPickerItem item) =>
