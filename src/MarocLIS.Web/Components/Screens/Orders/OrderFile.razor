    private async Task ReprintLabelsAsync(string reason)
    {
        _dialog = FileDialog.None;
        if (_detail is not { } detail || !Actions.PrintLabels) return;
        var caption = Texts["Action.LabelsPdf"];

        try
        {
            var pdf = await Scopes.RunAsync<MarocLIS.Web.Printing.LabelPdfService, Result<MarocLIS.Web.Printing.LabelPdf>>(
                s => s.ReprintAsync(detail.OrderId, reason));
            if (pdf.IsFailure)
            {
                Show(caption, Texts.Describe(pdf.Errors));
                return;
            }

            await JS.InvokeVoidAsync("marocLis.download", pdf.Value.FileName, "application/pdf", pdf.Value.Content);
            Show(caption, Texts.T("OrderEntry.LabelsDownloaded", pdf.Value.Count) + "\n" + Texts["OrderEntry.LabelsPdfHint"]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reprinting the labels of {Accession} failed.", detail.AccessionNumber);
            Show(caption, Texts[WebFailures.KeyFor(ex)]);
        }
    }

    /// <summary>
    /// The latest released report of the file, exactly as it was archived: a reprint gives what the
    /// clinician was given, never a fresh rendering of today's data. The browser downloads it.
    /// </summary>
    private async Task OpenReportAsync()
    {
        if (_detail is not { } detail || !Actions.PrintReport) return;
        var caption = Texts["Order.PrintReport"];

        try
        {
            var register = await Scopes.RunAsync<ReportReleaseService, Result<IReadOnlyList<ReportRegisterRow>>>(
                s => s.GetRegisterAsync(detail.AccessionNumber, withinDays: 3650));
            if (register.IsFailure)
            {
                Show(caption, Texts.Describe(register.Errors));
                return;
            }

            var latest = register.Value.Where(r => r.LabOrderId == detail.OrderId)
                                       .OrderByDescending(r => r.VersionNumber)
                                       .FirstOrDefault();
            if (latest is null)
            {
                Show(caption, Texts["Order.NoReportYet"]);
                return;
            }

            var pdf = await Scopes.RunAsync<ReportReleaseService, Result<byte[]>>(s => s.GetStoredPdfAsync(latest.ReportId));
            if (pdf.IsFailure)
            {
                Show(caption, Texts.Describe(pdf.Errors));
                return;
            }

            await JS.InvokeVoidAsync("marocLis.download", $"{detail.AccessionNumber}-v{latest.VersionNumber}.pdf",
                                     "application/pdf", pdf.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Opening the report of {Accession} failed.", detail.AccessionNumber);
            Show(caption, Texts[WebFailures.KeyFor(ex)]);
        }
    }

