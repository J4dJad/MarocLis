    private async Task AddAnalysesAsync((IReadOnlyList<Guid> Analyses, IReadOnlyList<Guid> Panels, string Reason) chosen)
    {
        if (_detail is not { } detail) return;
        _dialog = FileDialog.None;

        var result = await Scopes.RunAsync<OrderAmendmentService, Result<OrderAmendment>>(
            s => s.AddAnalysesAsync(detail.OrderId, chosen.Analyses, chosen.Panels, chosen.Reason));

        if (result.IsFailure)
        {
            Show(Texts["Order.AddAnalyses"], Texts.Describe(result.Errors));
            return;
        }

        var amendment = result.Value;
        var text = Texts.T("Order.AnalysesAdded", amendment.Pricing.Acts.Count, amendment.Pricing.Total.Format(Texts.Language, Texts.Culture));

        // A new tube means a new label: the workstation prints it with the addition; here it is
        // downloaded as the label PDF, from the message that opens with the addition.
        if (amendment.Labels.Count > 0) text += " — " + Texts["OrderEntry.LabelsAsPdf"];
        _status = (text, "normal");

        await ActivateAsync();

        // Warnings are shown, not swallowed: "added onto a tube already in the laboratory" is a job
        // for somebody, and it is not visible anywhere else.
        if (amendment.Labels.Count > 0)
        {
            var lines = new List<string> { text, Texts["OrderEntry.LabelsPdfHint"] };
            if (amendment.Warnings.Count > 0) lines.Add(Texts.Describe(amendment.Warnings));
            _message = new Message(Texts["Order.AddAnalyses"], string.Join("\n", lines), amendment.Labels);
            _dialog = FileDialog.Message;
        }
        else if (amendment.Warnings.Count > 0) Show(Texts["Order.AddAnalyses"], Texts.Describe(amendment.Warnings));
    }

