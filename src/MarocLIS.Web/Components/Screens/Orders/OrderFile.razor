    private async Task SelectTabAsync(FileTab tab)
    {
        _tab = tab;
        if (tab == FileTab.Prescription && _detail is { } detail) await LoadPrescriptionAsync(detail);
    }

    /// <summary>The prescription of the file, for its tab: read once per file, and shown.</summary>
    private async Task LoadPrescriptionAsync(OrderDetail detail)
    {
        if (!PrescriptionScanRules.CanView(detail, User))
        {
            _prescriptionFile = null;
            return;
        }

        if (_prescriptionFile is null)
        {
            try
            {
                var orderId = detail.OrderId;
                var file = await Scopes.RunAsync<PrescriptionScanService, Result<PrescriptionScanFile>>(s => s.GetAsync(orderId));
                if (_detail?.OrderId != orderId) return;
                if (file.IsFailure)
                {
                    _status = (Texts.Describe(file.Errors), "critical");
                    return;
                }

                _prescriptionFile = file.Value;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Loading the prescription of {Accession} failed.", detail.AccessionNumber);
                _status = (Texts[WebFailures.KeyFor(ex)], "critical");
                return;
            }
        }

        _previewPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_previewPending || _tab != FileTab.Prescription || _prescriptionFile is not { } file) return;
        _previewPending = false;

        try
        {
            await JS.InvokeVoidAsync("marocLis.preview", _previewFrame, file.ContentType, file.Content);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The prescription preview could not be shown.");
        }
    }

    /// <summary>Attaches the files (replacing, or after the pages there), assembled into one PDF.</summary>
    private async Task AttachPrescriptionAsync(IReadOnlyList<PrescriptionPage> pages, bool append)
    {
        if (_detail is not { } detail || _prescriptionBusy || !PrescriptionScanRules.CanChange(detail, User)) return;

        _prescriptionBusy = true;
        StateHasChanged();
        try
        {
            var orderId = detail.OrderId;
            var attached = await Scopes.RunAsync<PrescriptionScanService, Result<PrescriptionScanSummary>>(
                s => s.AttachAsync(orderId, pages, append));
            if (attached.IsFailure)
            {
                Show(Texts["Order.PrescriptionScan"], Texts.Describe(attached.Errors));
                return;
            }

            _status = (Texts["Order.PrescriptionSaved"], "normal");
            _prescriptionFile = null;
            await LoadDetailAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Attaching the prescription of {Accession} failed.", detail.AccessionNumber);
            Show(Texts["Order.PrescriptionScan"], Texts[WebFailures.KeyFor(ex)]);
        }
        finally
        {
            _prescriptionBusy = false;
        }
    }

    /// <summary>« Voir »: the PDF handed to the browser, through the download every screen uses.</summary>
    private async Task DownloadPrescriptionAsync()
    {
        if (_detail is not { } detail) return;
        await LoadPrescriptionAsync(detail);
        if (_prescriptionFile is { } file)
            await JS.InvokeVoidAsync("marocLis.download", file.FileName, file.ContentType, file.Content);
    }

