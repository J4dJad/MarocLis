    // ---- Roles ---------------------------------------------------------------------------------

    private void RoleCodeTyped(string code)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            CloseDialog();
            return;
        }

        _roleCode = code;
        _dialog = UsersDialog.RoleName;
    }

    /// <summary>
    /// Created with no rights at all, then granted in the tree: a role that arrives with a starter
    /// set nobody chose is how an over-privileged role gets into production.
    /// </summary>
    private async Task CreateRoleAsync(string name)
    {
        CloseDialog();
        if (_roleCode is not { } code || string.IsNullOrWhiteSpace(name)) return;

        Guid created = default;
        await RunAsync(Texts["Admin.NewRole"], async () =>
        {
            var result = await Scopes.RunAsync<UserAdministrationService, Result<Guid>>(
                s => s.CreateRoleAsync(code, new MultilingualText(name.Trim()), []));
            if (result.IsSuccess) created = result.Value;
            return result;
        }, async () =>
        {
            await LoadRolesAsync();
            // The new role made current: the notice sends the administrator to its rights.
            _roleId = created;
            ShowRolePermissions();
            Show(Texts["Admin.NewRole"], Texts["Admin.RoleCreatedNoPermissions"]);
        });
        _roleCode = null;
    }

    private async Task AskToggleRoleAsync()
    {
        if (SelectedRole is not { } role || !RoleActions.Toggle || _busy) return;

        // A role its holders still use is switched off only once their number is confirmed.
        if (UserAdministrationRules.DeactivationNeedsConfirmation(role))
        {
            _dialog = UsersDialog.ConfirmRoleDeactivation;
            return;
        }

        await ToggleRoleAsync();
    }

    /// <summary>A deactivated role stops granting its rights, but is not deleted: the audit trail refers to it.</summary>
    private async Task ToggleRoleAsync()
    {
        if (SelectedRole is not { } role) return;
        CloseDialog();
        var activating = !role.IsActive;

        await RunAsync(Texts["Admin.DeactivateRole"],
            () => Scopes.RunAsync<UserAdministrationService, Result>(s => s.SetRoleActiveAsync(role.RoleId, activating)),
            async () =>
            {
                await LoadRolesAsync();
                await LoadUsersAsync();
            });
    }

    private void AskSavePermissions()
    {
        if (SelectedRole is not { } role || !RoleActions.SavePermissions || _busy) return;

        _change = UserAdministrationRules.Change(role, _ticked);
        if (_change.IsNone)
        {
            _status = (Texts["Message.NoChanges"], "muted");
            return;
        }

        _dialog = UsersDialog.ConfirmPermissions;
    }

    private async Task SavePermissionsAsync()
    {
        if (SelectedRole is not { } role) return;
        CloseDialog();

        // In the catalogue's order, as the workstation's tree lists them.
        IReadOnlyList<string> selected = [.. _catalogue.SelectMany(m => m.Permissions).Where(_ticked.Contains)];

        await RunAsync(Texts["Admin.SavePermissions"],
            () => Scopes.RunAsync<UserAdministrationService, Result>(s => s.SetRolePermissionsAsync(role.RoleId, selected)),
            async () =>
            {
                await LoadRolesAsync();
                await LoadUsersAsync();
                _status = (Texts["Message.Saved"], "normal");
            });
    }
