    private async Task ToggleActiveAsync(string reason)
    {
        if (SelectedUser is not { } row) return;
        CloseDialog();
        var activating = !row.IsActive;

        await RunAsync(Texts[activating ? "Admin.Reactivate" : "Admin.Deactivate"],
            () => Scopes.RunAsync<UserAdministrationService, Result>(s => s.SetActiveAsync(row.UserId, activating, reason)),
            async () =>
            {
                // A deactivated account stays in view while the inactive ones are listed.
                await LoadUsersAsync();
                _status = ($"{Texts[activating ? "Admin.Reactivate" : "Admin.Deactivate"]} · {row.UserName}", "normal");
            });
