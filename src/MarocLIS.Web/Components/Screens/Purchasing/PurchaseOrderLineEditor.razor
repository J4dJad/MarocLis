@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@inject WebTexts Texts

@*
    One line of a draft order, the workstation's PurchaseOrderLineDialog: the article (those usually
    bought from this supplier first), how many, at what price, discount and VAT — the reorder
    quantity, the last price paid and the usual discount offered as starting values, a captive
    reagent at its contract's price. What is offered and refused is PurchaseOrderScreenRules'.
*@
<Modal Name="purchase-order-line" Title="@($"{Texts["PurchaseOrders.AddLine"]} — {Number}")" Hint="@Texts["StocksUi.Dialog.PurchaseOrderLine"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field field-span-2">
                <span class="field-label">@Texts["Inventory.Item"]</span>
                <select class="input @Refused(PurchaseOrderScreenRules.ItemField)" data-field="@PurchaseOrderScreenRules.ItemField"
                        value="@Form.StockItemId" @onchange="ItemChanged">
                    @foreach (var item in Items)
                    {
                        <option value="@item.Id">@PurchaseOrderScreenRules.ItemLabel(item, Texts.Language)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.ItemField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Field.Quantity"] @if (Current is { } current) { <span class="muted">(@current.UnitOfMeasure)</span> }</span>
                <input class="input mono strong num @Refused(PurchaseOrderScreenRules.QuantityField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@PurchaseOrderScreenRules.QuantityMaxLength" data-field="@PurchaseOrderScreenRules.QuantityField"
                       @bind="Form.Quantity" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.QuantityField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["PurchaseOrders.UnitPrice"]</span>
                <input class="input mono num @Refused(PurchaseOrderScreenRules.PriceField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@PurchaseOrderScreenRules.PriceMaxLength" data-field="@PurchaseOrderScreenRules.PriceField"
                       @bind="Form.UnitPrice" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.PriceField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["PurchaseOrders.DiscountPercent"]</span>
                <input class="input mono num @Refused(PurchaseOrderScreenRules.DiscountField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@PurchaseOrderScreenRules.RateMaxLength" data-field="@PurchaseOrderScreenRules.DiscountField"
                       @bind="Form.DiscountPercent" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.DiscountField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["PurchaseOrders.VatPercent"]</span>
                <input class="input mono num @Refused(PurchaseOrderScreenRules.VatField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@PurchaseOrderScreenRules.RateMaxLength" data-field="@PurchaseOrderScreenRules.VatField"
                       @bind="Form.VatPercent" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.VatField" />
            </label>
            <p class="field-span-2 small muted">@Texts["PurchaseOrders.LineNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public PurchaseOrderLineForm Form { get; set; } = default!;
    [Parameter, EditorRequired] public string Number { get; set; } = string.Empty;

    /// <summary>The articles, those usually bought from the order's supplier first (PurchaseOrderScreenRules.ItemsFor).</summary>
    [Parameter] public IReadOnlyList<OrderableItem> Items { get; set; } = [];
    [Parameter] public Guid? SupplierId { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<AddPurchaseOrderLineRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private FieldRefusal? _refusal;
    private bool _checked;

    private OrderableItem? Current => Items.FirstOrDefault(i => i.Id == Form.StockItemId);

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    /// <summary>Another article: its quantity, price and discount as starting values, as the workstation's.</summary>
    private void ItemChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || Items.FirstOrDefault(i => i.Id == id) is not { } item) return;
        PurchaseOrderScreenRules.Defaults(Form, item, SupplierId);
        _checked = false;
        _refusal = null;
    }

    private Task SaveAsync()
    {
        var (refusal, request) = PurchaseOrderScreenRules.CheckLine(Form);
        _refusal = refusal;
        _checked = true;
        return request is null ? Task.CompletedTask : OnSave.InvokeAsync(request);
    }
}
