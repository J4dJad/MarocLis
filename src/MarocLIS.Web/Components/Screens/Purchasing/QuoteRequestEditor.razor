@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@inject WebTexts Texts

@*
    A new request for quotation, the workstation's QuoteRequestDialog: its subject and the date an
    answer is wanted by, the articles to quote ticked with their quantity — the captive reagents of
    an instrument contract in force greyed with their contract, never quoted — and the suppliers to
    ask. What is checked and refused is QuoteScreenRules'.
*@
<Modal Name="quote-request" Title="@Texts["Quotes.New"]" Hint="@Texts["StocksUi.Dialog.QuoteRequest"]" Large="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Quotes.Subject"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@QuoteScreenRules.SubjectMaxLength"
                       data-field="@QuoteScreenRules.SubjectField" @bind="Form.Subject" @bind:event="oninput" />
            </label>
            <div class="field">
                <label class="field-check">
                    <input type="checkbox" data-field="quote-has-due" @bind="Form.HasResponseDue" />
                    <span>@Texts["Quotes.ResponseDue"]</span>
                </label>
                <input class="input input-date @Refused(QuoteScreenRules.DueField)" type="date" min="@Today.ToString("yyyy-MM-dd")"
                       aria-label="@Texts["Quotes.ResponseDue"]" disabled="@(!Form.HasResponseDue)"
                       data-field="@QuoteScreenRules.DueField" @bind="Form.ResponseDue" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@QuoteScreenRules.DueField" />
            </div>
        </div>
        <div class="quote-pick">
            <div class="field quote-pick-items">
                <span class="field-label">@Texts["Quotes.ItemsToQuote"]</span>
                <div class="table-scroll quote-pick-list @Refused(QuoteScreenRules.ItemsField)" data-field="@QuoteScreenRules.ItemsField">
                    <table class="grid" data-grid="quote-items">
                        <thead>
                            <tr>
                                <th class="cell-check"><span class="visually-hidden">@Texts["Quotes.ItemsToQuote"]</span></th>
                                <th>@Texts["Inventory.Item"]</th>
                                <th class="num">@Texts["Field.Quantity"]</th>
                                <th>@Texts["Quotes.OnContract"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Form.Items.Count; i++)
                            {
                                var line = Form.Items[i];
                                var field = QuoteScreenRules.QuantityField(i);
                                var label = QuoteScreenRules.ItemLabel(line.Item, Texts.Language);
                                <tr class="@(line.OnContract ? "is-tone-muted" : null)" data-row="@line.Item.Code">
                                    <td class="cell-check">
                                        <input type="checkbox" aria-label="@label" disabled="@line.OnContract" data-field="quote-include-@i" @bind="line.Included" />
                                    </td>
                                    <td><span class="cell-wrap" title="@label">@label</span></td>
                                    <td class="num stock-count">
                                        <input class="input mono num @Refused(field)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                                               aria-label="@Texts["Field.Quantity"]" maxlength="@QuoteScreenRules.QuantityMaxLength" disabled="@line.OnContract"
                                               data-field="@field" @bind="line.Quantity" @bind:event="oninput" />
                                        <span class="muted small">@line.Item.UnitOfMeasure</span>
                                        <FieldMessage Refusal="Shown" Field="@field" />
                                    </td>
                                    <td class="small"><span class="cell-wrap" dir="ltr">@line.Item.ContractReference</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <FieldMessage Refusal="Shown" Field="@QuoteScreenRules.ItemsField" />
            </div>
            <div class="field quote-pick-suppliers">
                <span class="field-label">@Texts["Quotes.SuppliersToAsk"]</span>
                <ul class="check-list quote-pick-list @Refused(QuoteScreenRules.SuppliersField)" data-field="@QuoteScreenRules.SuppliersField">
                    @foreach (var supplier in Suppliers)
                    {
                        var id = supplier.Id;
                        <li>
                            <label class="field-check">
                                <input type="checkbox" checked="@Form.SupplierIds.Contains(id)" data-field="quote-supplier-@supplier.Code"
                                       @onchange="e => Toggle(id, e)" />
                                <span class="cell-wrap">@QuoteScreenRules.OptionLabel(supplier, Texts.T)</span>
                            </label>
                        </li>
                    }
                </ul>
                <FieldMessage Refusal="Shown" Field="@QuoteScreenRules.SuppliersField" />
            </div>
        </div>
        <label class="field">
            <span class="field-label">@Texts["Field.Notes"]</span>
            <input class="input" type="text" autocomplete="off" maxlength="@QuoteScreenRules.NotesMaxLength"
                   data-field="quote-notes" @bind="Form.Notes" @bind:event="oninput" />
        </label>
        <p class="small muted">@Texts["Quotes.OnContractNotice"]</p>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public QuoteRequestForm Form { get; set; } = default!;
    [Parameter] public IReadOnlyList<QuoteSupplierOption> Suppliers { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<CreateQuoteRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private FieldRefusal? _refusal;
    private bool _checked;

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    private void Toggle(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) Form.SupplierIds.Add(id);
        else Form.SupplierIds.Remove(id);
    }

    private Task SaveAsync()
    {
        var (refusal, request) = QuoteScreenRules.CheckRequest(Form, [.. Suppliers.Select(s => s.Id)], Today);
        _refusal = refusal;
        _checked = true;
        return request is null ? Task.CompletedTask : OnSave.InvokeAsync(request);
    }
}
