@using MarocLIS.Application.Input
@using MarocLIS.Application.Inventory
@inject WebTexts Texts

@*
    A new order, the workstation's PurchaseOrderDialog: who it goes to (an approved supplier), when
    the goods are wanted (optional), the supplier's quote or proforma reference and notes. Lines
    come next. What is checked and refused box by box is PurchaseOrderScreenRules'.
*@
<Modal Name="purchase-order" Title="@Texts["PurchaseOrders.NewOrder"]" Hint="@Texts["StocksUi.Dialog.PurchaseOrder"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field field-span-2">
                <span class="field-label">@Texts["Inventory.Supplier"]</span>
                <select class="input @Refused(PurchaseOrderScreenRules.SupplierField)" data-field="@PurchaseOrderScreenRules.SupplierField" @bind="Form.SupplierId">
                    <option value="">—</option>
                    @foreach (var supplier in Suppliers)
                    {
                        <option value="@supplier.Id">@PurchaseOrderScreenRules.SupplierLabel(supplier)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.SupplierField" />
            </label>
            <div class="field">
                <label class="field-check">
                    <input type="checkbox" data-field="po-has-expected" @bind="Form.HasExpectedDelivery" />
                    <span>@Texts["PurchaseOrders.ExpectedDelivery"]</span>
                </label>
                <input class="input input-date @Refused(PurchaseOrderScreenRules.ExpectedField)" type="date" min="@Today.ToString("yyyy-MM-dd")"
                       aria-label="@Texts["PurchaseOrders.ExpectedDelivery"]" disabled="@(!Form.HasExpectedDelivery)"
                       data-field="@PurchaseOrderScreenRules.ExpectedField" @bind="Form.ExpectedDelivery" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@PurchaseOrderScreenRules.ExpectedField" />
            </div>
            <label class="field">
                <span class="field-label">@Texts["PurchaseOrders.SupplierReference"]</span>
                <input class="input mono" type="text" dir="ltr" autocomplete="off" maxlength="@PurchaseOrderScreenRules.SupplierReferenceMaxLength"
                       data-field="po-reference" @bind="Form.SupplierReference" @bind:event="oninput" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Notes"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@PurchaseOrderScreenRules.NotesMaxLength"
                       data-field="po-notes" @bind="Form.Notes" @bind:event="oninput" />
            </label>
            <p class="field-span-2 small muted" data-state="approval-notice">@Texts["PurchaseOrders.ApprovalNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public PurchaseOrderForm Form { get; set; } = default!;
    [Parameter] public IReadOnlyList<SupplierOption> Suppliers { get; set; } = [];
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<CreatePurchaseOrderRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private FieldRefusal? _refusal;
    private bool _checked;

    private FieldRefusal? Shown => _checked ? _refusal : FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = false;
    }

    private Task SaveAsync()
    {
        var (refusal, request) = PurchaseOrderScreenRules.CheckOrder(Form, Today);
        _refusal = refusal;
        _checked = true;
        return request is null ? Task.CompletedTask : OnSave.InvokeAsync(request);
    }
}
