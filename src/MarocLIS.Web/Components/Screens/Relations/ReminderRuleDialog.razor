@using MarocLIS.Application.Input
@using MarocLIS.Application.Relations
@using MarocLIS.Domain.Relations
@inject WebTexts Texts

@*
    A bilan reminder rule, the workstation's rule editor: the analysis or panel followed, the delay
    after the result, the window within which the reminder is still sent, the wording in French and
    in Arabic (the fields it may use under it) and whether the rule is in force. Checked as
    PatientMessagingScreenRules.Check checks it, a refusal beside its box.
*@
<Modal Name="reminder-rule" Title="@Texts[Rule is null ? "Messaging.NewRule" : "Messaging.EditRule"]" Hint="@Texts["Messaging.RuleIntro"]"
       Large="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-3">
            <label class="field">
                <span class="field-label">@Texts["Messaging.Column.analysis"]</span>
                <select class="input @Refused(PatientMessagingScreenRules.RuleTargetField)" data-field="@PatientMessagingScreenRules.RuleTargetField" @bind="_target">
                    <option value="@Guid.Empty">—</option>
                    @foreach (var t in Targets)
                    {
                        <option value="@t.Id">@PatientMessagingScreenRules.Display(t, Texts.Language, Texts.T)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.RuleTargetField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Messaging.Column.delay"]</span>
                <input class="input mono num @Refused(PatientMessagingScreenRules.RuleDelayField)" type="text" inputmode="numeric" dir="ltr" autocomplete="off"
                       maxlength="4" data-field="@PatientMessagingScreenRules.RuleDelayField" @bind="_delay" @bind:event="oninput" />
                @if (Shown?.Field == PatientMessagingScreenRules.RuleDelayField)
                {
                    <span class="message is-warning small" role="alert" data-refusal="@PatientMessagingScreenRules.RuleDelayField">@PatientMessagingScreenRules.DelayRefusal(Texts.T)</span>
                }
            </label>
            <label class="field">
                <span class="field-label">@Texts["Messaging.Column.window"]</span>
                <input class="input mono num @Refused(PatientMessagingScreenRules.RuleWindowField)" type="text" inputmode="numeric" dir="ltr" autocomplete="off"
                       maxlength="4" data-field="@PatientMessagingScreenRules.RuleWindowField" @bind="_window" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.RuleWindowField" />
            </label>
            <label class="field field-span-all">
                <span class="field-label">@Texts["Messaging.TemplateFr"]</span>
                <textarea class="input @Refused(PatientMessagingScreenRules.RuleTemplateFrField)" rows="3" maxlength="@MessageWording.MaximumLength"
                          data-field="@PatientMessagingScreenRules.RuleTemplateFrField" @bind="_fr" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.RuleTemplateFrField" />
            </label>
            <label class="field field-span-all">
                <span class="field-label">@Texts["Messaging.TemplateAr"]</span>
                <textarea class="input @Refused(PatientMessagingScreenRules.RuleTemplateArField)" rows="3" dir="rtl" maxlength="@MessageWording.MaximumLength"
                          data-field="@PatientMessagingScreenRules.RuleTemplateArField" @bind="_ar" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.RuleTemplateArField" />
            </label>
            <p class="field-span-all small muted text-full" data-state="placeholders" dir="auto">@PatientMessagingScreenRules.PlaceholdersHelp(Texts.T)</p>
            <label class="field-check">
                <input type="checkbox" data-field="rule-active" @bind="_active" />
                <span>@Texts["Field.Active"]</span>
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    /// <summary>The rule being changed; none for a new one.</summary>
    [Parameter] public ReminderRuleRow? Rule { get; set; }

    /// <summary>The analyses and panels offered (the rule's own kept, even no longer offered).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ReminderTarget> Targets { get; set; } = [];

    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SaveReminderRuleRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Guid _target;
    private string? _delay, _window, _fr, _ar;
    private bool _active;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized()
    {
        var f = PatientMessagingScreenRules.FormFor(Rule, Texts.Culture);
        (_target, _delay, _window, _fr, _ar, _active) = (f.TargetId, f.Delay, f.Window, f.TemplateFr, f.TemplateAr, f.IsActive);
    }

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var (refused, request) = PatientMessagingScreenRules.Check(new ReminderRuleForm(_target, _delay, _window, _fr, _ar, _active), Targets, Rule?.Id);
        _checked = refused;
        return refused is null ? OnSave.InvokeAsync(request!) : Task.CompletedTask;
    }
}
