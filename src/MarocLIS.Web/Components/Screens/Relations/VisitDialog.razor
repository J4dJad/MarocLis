@using System.Globalization
@using MarocLIS.Application.Input
@using MarocLIS.Application.Relations
@using MarocLIS.Domain.Relations
@inject WebTexts Texts

@*
    A delegate's visit, the workstation's visit editor: the day, the prescriber visited, the
    delegate, the purpose, the report of the visit and the next one planned. Checked as
    RelationsScreenRules.Check checks it, a refusal beside its box.
*@
<Modal Name="visit" Title="@Texts[Visit is null ? "Relations.NewVisit" : "Relations.EditVisit"]" Hint="@Texts["Relations.VisitIntro"]" Wide="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Field.Date"]</span>
                <input class="input input-date @Refused(RelationsScreenRules.VisitDateField)" type="date" data-field="@RelationsScreenRules.VisitDateField"
                       max="@Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @bind="_date" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.VisitDateField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.purpose"]</span>
                <select class="input" data-field="visit-purpose" @bind="_purpose">
                    @foreach (var purpose in Enum.GetValues<VisitPurpose>())
                    {
                        <option value="@purpose">@Texts[$"VisitPurpose.{purpose}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.prescriber"]</span>
                <select class="input @Refused(RelationsScreenRules.VisitPrescriberField)" data-field="@RelationsScreenRules.VisitPrescriberField" @bind="_prescriber">
                    <option value="@Guid.Empty">—</option>
                    @foreach (var p in Options.Prescribers)
                    {
                        <option value="@p.Id">@RelationsScreenRules.Display(p, Texts.T)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.VisitPrescriberField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.delegate"]</span>
                <select class="input @Refused(RelationsScreenRules.VisitDelegateField)" data-field="@RelationsScreenRules.VisitDelegateField" @bind="_delegate">
                    <option value="@Guid.Empty">—</option>
                    @foreach (var s in Options.Staff)
                    {
                        <option value="@s.Id">@RelationsScreenRules.Display(s, Texts.T)</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.VisitDelegateField" />
            </label>
            <label class="field field-span-all">
                <span class="field-label">@Texts["Relations.Column.notes"]</span>
                <textarea class="input @Refused(RelationsScreenRules.VisitNotesField)" rows="4" maxlength="@DelegateVisit.NotesMaxLength"
                          data-field="@RelationsScreenRules.VisitNotesField" @bind="_notes" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.VisitNotesField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.next"]</span>
                <input class="input input-date @Refused(RelationsScreenRules.VisitNextField)" type="date" data-field="@RelationsScreenRules.VisitNextField"
                       @bind="_next" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.VisitNextField" />
            </label>
            <p class="field-span-all message is-info small text-full" data-state="visit-notice">@Texts["Relations.FollowUpNotice"]</p>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    /// <summary>The visit being changed; none for a new one.</summary>
    [Parameter] public DelegateVisitRow? Visit { get; set; }

    /// <summary>The prescribers and staff to choose from (those the visit names kept, even switched off).</summary>
    [Parameter, EditorRequired] public RelationOptions Options { get; set; } = default!;

    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SaveDelegateVisitRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DateOnly _date;
    private DateOnly? _next;
    private Guid _prescriber, _delegate;
    private VisitPurpose _purpose;
    private string? _notes;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized()
    {
        var form = RelationsScreenRules.FormFor(Visit, CurrentUserId, Today);
        (_date, _prescriber, _delegate, _purpose, _notes, _next) =
            (form.VisitDate, form.PrescriberId, form.DelegateUserId, form.Purpose, form.Notes, form.NextVisitOn);
    }

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var (refused, request) = RelationsScreenRules.Check(new VisitForm(_date, _prescriber, _delegate, _purpose, _notes, _next), Visit?.Id, Today);
        _checked = refused;
        return refused is null ? OnSave.InvokeAsync(request!) : Task.CompletedTask;
    }
}
