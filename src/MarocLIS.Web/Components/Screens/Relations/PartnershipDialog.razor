@using System.Globalization
@using MarocLIS.Application.Input
@using MarocLIS.Application.Relations
@using MarocLIS.Domain.Relations
@inject WebTexts Texts

@*
    A convention with a clinic, a company or a partner laboratory, the workstation's convention
    editor: the partner and its record in the prescriber file, the kind of agreement, its reference
    and period, the terms agreed, the discount and payment delay, the partner's ICE and whom to
    call. Checked as RelationsScreenRules.Check checks it, a refusal beside its box.
*@
<Modal Name="partnership" Title="@Texts[Detail is null ? "Relations.NewPartnership" : "Relations.EditPartnership"]"
       Hint="@Texts["Relations.PartnershipIntro"]" Large="true" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-3">
            <label class="field field-span-2">
                <span class="field-label">@Texts["Relations.Column.partner"]</span>
                <input class="input @Refused(RelationsScreenRules.PartnerNameField)" type="text" autocomplete="off" maxlength="@RelationsScreenRules.PartnerNameMaxLength"
                       data-field="@RelationsScreenRules.PartnerNameField" title="@_name" @bind="_name" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerNameField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.partnerKind"]</span>
                <select class="input" data-field="partner-kind" @bind="_partnerKind">
                    @foreach (var kind in Enum.GetValues<PartnerKind>())
                    {
                        <option value="@kind">@Texts[$"PartnerKind.{kind}"]</option>
                    }
                </select>
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Relations.LinkedPrescriber"]</span>
                <select class="input" data-field="partner-prescriber" @bind="_prescriber">
                    <option value="@Guid.Empty">—</option>
                    @foreach (var p in Options.Prescribers)
                    {
                        <option value="@p.Id">@RelationsScreenRules.Display(p, Texts.T)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.kind"]</span>
                <select class="input" data-field="partnership-kind" @bind="_kind">
                    @foreach (var kind in Enum.GetValues<PartnershipKind>())
                    {
                        <option value="@kind">@Texts[$"PartnershipKind.{kind}"]</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.reference"]</span>
                <input class="input mono" type="text" dir="ltr" autocomplete="off" maxlength="@RelationsScreenRules.ReferenceMaxLength" data-field="partner-reference"
                       title="@_reference" @bind="_reference" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.start"]</span>
                <input class="input input-date" type="date" data-field="@RelationsScreenRules.PartnerStartField" @bind="_start" @bind:format="yyyy-MM-dd" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.end"]</span>
                <input class="input input-date @Refused(RelationsScreenRules.PartnerEndField)" type="date" data-field="@RelationsScreenRules.PartnerEndField"
                       @bind="_end" @bind:format="yyyy-MM-dd" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerEndField" />
            </label>
            <label class="field field-span-all">
                <span class="field-label">@Texts["Relations.Terms"]</span>
                <textarea class="input @Refused(RelationsScreenRules.PartnerTermsField)" rows="3" maxlength="@Partnership.TermsMaxLength"
                          data-field="@RelationsScreenRules.PartnerTermsField" @bind="_terms" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerTermsField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.Column.discount"]</span>
                <input class="input mono num @Refused(RelationsScreenRules.PartnerDiscountField)" type="text" inputmode="decimal" dir="ltr" autocomplete="off"
                       maxlength="@RelationsScreenRules.NumberMaxLength" data-field="@RelationsScreenRules.PartnerDiscountField" @bind="_discount" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerDiscountField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.PaymentTermsDays"]</span>
                <input class="input mono num @Refused(RelationsScreenRules.PartnerPaymentField)" type="text" inputmode="numeric" dir="ltr" autocomplete="off"
                       maxlength="@RelationsScreenRules.NumberMaxLength" data-field="@RelationsScreenRules.PartnerPaymentField" @bind="_payment" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerPaymentField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Billing.Ice"]</span>
                <input class="input mono @Refused(RelationsScreenRules.PartnerIceField)" type="text" dir="ltr" autocomplete="off" maxlength="@RelationsScreenRules.IceMaxLength"
                       data-field="@RelationsScreenRules.PartnerIceField" @bind="_ice" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@RelationsScreenRules.PartnerIceField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Relations.ContactName"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@RelationsScreenRules.ContactNameMaxLength" data-field="partner-contact"
                       title="@_contact" @bind="_contact" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Field.Phone"]</span>
                <input class="input mono" type="tel" dir="ltr" autocomplete="off" maxlength="@RelationsScreenRules.PhoneMaxLength" data-field="partner-phone"
                       @bind="_phone" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Field.Email"]</span>
                <input class="input" type="email" dir="ltr" autocomplete="off" maxlength="@RelationsScreenRules.EmailMaxLength" data-field="partner-email"
                       title="@_email" @bind="_email" @bind:event="oninput" />
            </label>
            <label class="field field-span-2">
                <span class="field-label">@Texts["Field.Notes"]</span>
                <input class="input" type="text" autocomplete="off" maxlength="@RelationsScreenRules.PartnershipNotesMaxLength" data-field="partner-notes"
                       title="@_notes" @bind="_notes" @bind:event="oninput" />
            </label>
            <label class="field-check field-align-end">
                <input type="checkbox" data-field="partner-active" @bind="_active" />
                <span>@Texts["Field.Active"]</span>
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    /// <summary>The convention being changed; none for a new one.</summary>
    [Parameter] public PartnershipDetail? Detail { get; set; }

    /// <summary>The prescribers to link it to (the one it names kept, even switched off).</summary>
    [Parameter, EditorRequired] public RelationOptions Options { get; set; } = default!;

    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SavePartnershipRequest> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _name = string.Empty;
    private PartnerKind _partnerKind;
    private Guid _prescriber;
    private PartnershipKind _kind;
    private string? _reference, _terms, _discount, _payment, _ice, _contact, _phone, _email, _notes;
    private DateOnly _start;
    private DateOnly? _end;
    private bool _active;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized()
    {
        var f = RelationsScreenRules.FormFor(Detail, Today, Texts.Culture);
        _name = f.PartnerName;
        _partnerKind = f.PartnerKind;
        _prescriber = f.PrescriberId ?? Guid.Empty;
        _kind = f.Kind;
        _reference = f.Reference;
        _start = f.StartDate;
        _end = f.EndDate;
        _terms = f.Terms;
        _discount = f.Discount;
        _payment = f.PaymentDays;
        _ice = f.Ice;
        _contact = f.ContactName;
        _phone = f.ContactPhone;
        _email = f.ContactEmail;
        _notes = f.Notes;
        _active = f.IsActive;
    }

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var form = new PartnershipForm
        {
            PartnerName = _name,
            PartnerKind = _partnerKind,
            PrescriberId = _prescriber == Guid.Empty ? null : _prescriber,
            Kind = _kind,
            Reference = _reference,
            StartDate = _start,
            EndDate = _end,
            Terms = _terms,
            Discount = _discount,
            PaymentDays = _payment,
            Ice = _ice,
            ContactName = _contact,
            ContactPhone = _phone,
            ContactEmail = _email,
            Notes = _notes,
            IsActive = _active
        };
        var (refused, request) = RelationsScreenRules.Check(form, Detail?.Id);
        _checked = refused;
        return refused is null ? OnSave.InvokeAsync(request!) : Task.CompletedTask;
    }
}
