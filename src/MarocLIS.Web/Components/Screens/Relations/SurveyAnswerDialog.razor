@using MarocLIS.Application.Input
@using MarocLIS.Application.Relations
@using MarocLIS.Domain.Relations
@inject WebTexts Texts

@*
    An answer given at the desk or by telephone, the workstation's « Saisir une réponse »: the code
    the survey's SMS gave, the score from one to five and the patient's comment. Checked as
    PatientMessagingScreenRules.Check checks it, a refusal beside its box.
*@
<Modal Name="survey-answer" Title="@Texts["Messaging.RecordAnswer"]" Hint="@Texts["Messaging.RecordAnswerIntro"]" OnCancel="OnCancel">
    <ChildContent>
        <div class="form-grid form-grid-2">
            <label class="field">
                <span class="field-label">@Texts["Messaging.SurveyCode"]</span>
                <input class="input mono @Refused(PatientMessagingScreenRules.AnswerCodeField)" type="text" dir="ltr" autocomplete="off" maxlength="12"
                       data-field="@PatientMessagingScreenRules.AnswerCodeField" @bind="_code" @bind:event="oninput" />
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.AnswerCodeField" />
            </label>
            <label class="field">
                <span class="field-label">@Texts["Messaging.Column.score"]</span>
                <select class="input @Refused(PatientMessagingScreenRules.AnswerScoreField)" data-field="@PatientMessagingScreenRules.AnswerScoreField" @bind="_score">
                    @for (var s = 5; s >= 1; s--)
                    {
                        var score = s.ToString(Texts.Culture);
                        <option value="@score">@($"{score} ★")</option>
                    }
                </select>
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.AnswerScoreField" />
            </label>
            <label class="field field-span-all">
                <span class="field-label">@Texts["Messaging.Column.comment"]</span>
                <textarea class="input @Refused(PatientMessagingScreenRules.AnswerCommentField)" rows="3" maxlength="@SurveyInvitation.CommentMaxLength"
                          data-field="@PatientMessagingScreenRules.AnswerCommentField" @bind="_comment" @bind:event="oninput"></textarea>
                <FieldMessage Refusal="Shown" Field="@PatientMessagingScreenRules.AnswerCommentField" />
            </label>
        </div>
        @if (Refusal is { Length: > 0 } refused)
        {
            <p class="message is-critical text-full" role="alert" data-state="refusal">@refused</p>
        }
    </ChildContent>
    <Footer>
        <ActionButton Key="Action.Cancel" OnClick="OnCancel" />
        <ActionButton Key="Action.Save" Primary="true" Disabled="Busy" OnClick="SaveAsync" />
    </Footer>
</Modal>

@code {
    [Parameter] public string? Refusal { get; set; }
    [Parameter] public FieldRefusal? FieldRefusal { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(string Code, int Score, string? Comment)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string? _code, _comment;
    private string? _score;
    private FieldRefusal? _checked;

    private FieldRefusal? Shown => _checked ?? FieldRefusal;

    private string? Refused(string field) => Shown?.Field == field ? "is-refused" : null;

    protected override void OnInitialized() => _score = 5.ToString(Texts.Culture);

    protected override void OnParametersSet()
    {
        if (FieldRefusal is not null) _checked = null;
    }

    private Task SaveAsync()
    {
        var (refused, answer) = PatientMessagingScreenRules.Check(new SurveyAnswerForm(_code, _score, _comment));
        _checked = refused;
        return refused is null ? OnSave.InvokeAsync(answer!.Value) : Task.CompletedTask;
    }
}
