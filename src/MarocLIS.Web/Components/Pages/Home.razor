@page "/"
@inject WebTexts Texts
@inject SessionContext Context
@inject MarocLIS.Application.Licensing.ILicenceState Licence

<PageTitle>MarocLIS — @Texts["Web.Home.Title"]</PageTitle>

<div class="page">
    <h1 class="page-title">@Texts.T("Web.Home.Welcome", Context.User.FullName)</h1>
    <p class="page-lead">@Texts["Web.Home.Intro"]</p>

    <div class="card">
        <dl class="facts">
            <dt>@Texts["App.ConnectedAs"]</dt>
            <dd><bdi>@Context.User.UserName</bdi></dd>
            <dt>@Texts["App.Site"]</dt>
            <dd>@Context.User.SiteCode</dd>
            <dt>@Texts["App.Workstation"]</dt>
            <dd><bdi>@Context.Session?.Workstation</bdi></dd>
            <dt>@Texts["Web.Home.Today"]</dt>
            <dd>@DateTime.Now.ToString("dddd d MMMM yyyy", Texts.Culture)</dd>
        </dl>
    </div>

    @* The workstation opens on its dashboard, the first entry of the menu: the web's home leads to it. *@
    @if (MarocLIS.Application.Navigation.NavigationMenu.Find("dashboard") is { } dashboard
         && MarocLIS.Application.Navigation.NavigationMenu.IsPermitted(dashboard, Context.User, Licence.Current))
    {
        <a class="card home-dashboard" href="@WebMenu.HrefOf("dashboard")" data-action="open-dashboard">
            <Icon Glyph="WebMenu.IconOf(dashboard.Key)" Class="icon-title" />
            <span class="home-dashboard-text">
                <strong>@Texts[dashboard.LabelKey]</strong>
                <span class="muted small">@Texts["Web.Home.DashboardHint"]</span>
            </span>
        </a>
    }
</div>
