@page "/ecran/{Key}"
@using MarocLIS.Application.Abstractions
@using MarocLIS.Application.Licensing
@using MarocLIS.Domain.Audit
@inject WebTexts Texts
@inject SessionContext Context
@inject ILicenceState Licence
@inject IPermissionGuard Guard
@inject ISecurityAuditor Auditor

@*
    A screen of the menu. Opened only by the rule that builds the menu: a screen the operator may not
    see is refused here too when its address is typed, and the refusal is recorded as the services
    record one. The screens ported so far open here; the others say they are not yet in the web
    version.
*@
<PageTitle>MarocLIS — @Title</PageTitle>

<div class="page @(_decision == ScreenDecision.Open ? "page-screen" : null)">
    <h1 class="page-title">
        @if (_decision == ScreenDecision.Open)
        {
            <Icon Glyph="WebMenu.IconOf(Key)" Class="icon-title" />
        }
        @Title
    </h1>

    @switch (_decision)
    {
        case ScreenDecision.Open when Key == "dashboard":
            <MarocLIS.Web.Components.Screens.Steering.DashboardScreen />
            break;

        case ScreenDecision.Open when Key == "statistics":
            <MarocLIS.Web.Components.Screens.Steering.ActivityStatisticsScreen />
            break;

        case ScreenDecision.Open when Key == "steering":
            <MarocLIS.Web.Components.Screens.Steering.SteeringScreen />
            break;

        case ScreenDecision.Open when Key == "patients":
            <MarocLIS.Web.Components.Screens.Patients.PatientSearch />
            break;

        case ScreenDecision.Open when Key == "orders":
            <MarocLIS.Web.Components.Screens.Orders.OrderRegistration PatientToSelect="Patient" />
            break;

        case ScreenDecision.Open when Key == "orderdetail":
            <MarocLIS.Web.Components.Screens.Orders.OrderFile OrderId="Dossier" />
            break;

        case ScreenDecision.Open when Key == "collection":
            <MarocLIS.Web.Components.Screens.Samples.Collection />
            break;

        case ScreenDecision.Open when Key == "reception":
            <MarocLIS.Web.Components.Screens.Samples.SampleReception />
            break;

        case ScreenDecision.Open when Key == "serumbank":
            <MarocLIS.Web.Components.Screens.Samples.SampleStorage />
            break;

        case ScreenDecision.Open when Key == "subcontracting":
            <MarocLIS.Web.Components.Screens.Samples.Subcontracting />
            break;

        case ScreenDecision.Open when Key == "personnel":
            <MarocLIS.Web.Components.Screens.HumanResources.PersonnelScreen />
            break;

        case ScreenDecision.Open when Key == "habilitations":
            <MarocLIS.Web.Components.Screens.HumanResources.HabilitationsScreen />
            break;

        case ScreenDecision.Open when Key == "hrdeadlines":
            <MarocLIS.Web.Components.Screens.HumanResources.PersonnelDeadlinesScreen />
            break;

        case ScreenDecision.Open when Key == "leave":
            <MarocLIS.Web.Components.Screens.HumanResources.LeaveScreen />
            break;

        case ScreenDecision.Open when Key == "planning":
            <MarocLIS.Web.Components.Screens.HumanResources.PlanningScreen />
            break;

        case ScreenDecision.Open when Key == "payroll":
            <MarocLIS.Web.Components.Screens.HumanResources.PayrollScreen />
            break;

        case ScreenDecision.Open when Key == "accidents":
            <MarocLIS.Web.Components.Screens.HumanResources.AccidentScreen />
            break;


        case ScreenDecision.Open when Key == "recollections":
            <MarocLIS.Web.Components.Screens.Samples.Recollections />
            break;

        case ScreenDecision.Open when Key == "entry":
            <MarocLIS.Web.Components.Screens.Results.ResultEntryScreen OrderId="Dossier" />
            break;

        case ScreenDecision.Open when Key == "validation":
            <MarocLIS.Web.Components.Screens.Results.BiologicalValidation />
            break;

        case ScreenDecision.Open when Key == "reports":
            <MarocLIS.Web.Components.Screens.Reports.ReportRegister Search="@Recherche" />
            break;

        case ScreenDecision.Open when Key == "billing":
            <MarocLIS.Web.Components.Screens.Billing.BillingDesk Search="@Recherche" />
            break;

        case ScreenDecision.Open when Key == "cash":
            <MarocLIS.Web.Components.Screens.Billing.CashDesk />
            break;

        case ScreenDecision.Open when Key == "claims":
            <MarocLIS.Web.Components.Screens.Billing.ClaimBatches />
            break;

        case ScreenDecision.Open when Key == "cashreview":
            <MarocLIS.Web.Components.Screens.Billing.CashReview />
            break;

        case ScreenDecision.Open when Key == "users":
            <MarocLIS.Web.Components.Screens.Admin.UserAdministration />
            break;

        case ScreenDecision.Open when Key == "audit":
            <MarocLIS.Web.Components.Screens.Admin.AuditTrail />
            break;

        case ScreenDecision.Open when Key == "settings":
            <MarocLIS.Web.Components.Screens.Admin.Settings Tab="@Onglet" />
            break;

        case ScreenDecision.Open when Key == "catalog":
            <MarocLIS.Web.Components.Screens.Catalog.CatalogScreen />
            break;

        case ScreenDecision.Open when Key == "masterdata":
            <MarocLIS.Web.Components.Screens.MasterData.MasterDataScreen />
            break;

        case ScreenDecision.Open when Key == "interfaces":
            <MarocLIS.Web.Components.Screens.Instruments.InstrumentInterfaces />
            break;

        case ScreenDecision.Open when Key == "qc":
            <MarocLIS.Web.Components.Screens.Quality.QualityControl />
            break;

        case ScreenDecision.Open when Key == "nonconformities":
            <MarocLIS.Web.Components.Screens.Quality.NonConformities />
            break;

        case ScreenDecision.Open when Key == "eqa":
            <MarocLIS.Web.Components.Screens.Quality.ExternalQuality />
            break;

        case ScreenDecision.Open when Key == "documents":
            <MarocLIS.Web.Components.Screens.Quality.QualityDocuments />
            break;

        case ScreenDecision.Open when Key == "inventory":
            <MarocLIS.Web.Components.Screens.Stock.InventoryScreen />
            break;

        case ScreenDecision.Open when Key == "consumption":
            <MarocLIS.Web.Components.Screens.Stock.ConsumptionScreen />
            break;

        case ScreenDecision.Open when Key == "inventorycounts":
            <MarocLIS.Web.Components.Screens.Stock.InventoryCounts />
            break;

        case ScreenDecision.Open when Key == "temperatures":
            <MarocLIS.Web.Components.Screens.Stock.Temperatures />
            break;

        case ScreenDecision.Open when Key == "purchaseorders":
            <MarocLIS.Web.Components.Screens.Purchasing.PurchaseOrders />
            break;

        case ScreenDecision.Open when Key == "quotes":
            <MarocLIS.Web.Components.Screens.Purchasing.QuoteRequests />
            break;

        case ScreenDecision.Open when Key == "supplierinvoices":
            <MarocLIS.Web.Components.Screens.Purchasing.SupplierInvoices />
            break;

        case ScreenDecision.Open when Key == "supplierevaluation":
            <MarocLIS.Web.Components.Screens.Purchasing.SupplierEvaluation />
            break;

        case ScreenDecision.Open when Key == "equipment":
            <MarocLIS.Web.Components.Screens.Equipment.EquipmentScreen />
            break;

        case ScreenDecision.Open when Key == "contracts":
            <MarocLIS.Web.Components.Screens.Equipment.InstrumentContracts />
            break;

        case ScreenDecision.Open when Key == "accountingexport":
            <MarocLIS.Web.Components.Screens.Finance.AccountingExport />
            break;

        case ScreenDecision.Open when Key == "accountingsettings":
            <MarocLIS.Web.Components.Screens.Finance.AccountingSettings />
            break;

        case ScreenDecision.Open when Key == "fixedassets":
            <MarocLIS.Web.Components.Screens.Finance.FixedAssets />
            break;

        case ScreenDecision.Open when Key == "bankreconciliation":
            <MarocLIS.Web.Components.Screens.Finance.BankReconciliation />
            break;

        case ScreenDecision.Open when Key == "cashforecast":
            <MarocLIS.Web.Components.Screens.Finance.CashForecast />
            break;

        case ScreenDecision.Open when Key == "costmargin":
            <MarocLIS.Web.Components.Screens.Finance.CostMargin />
            break;

        case ScreenDecision.Open when Key == "migration":
            <MarocLIS.Web.Components.Screens.Migration.DataMigration />
            break;

        case ScreenDecision.Open:
            <div class="card card-empty" data-state="unavailable">
                <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Cpu" Class="icon-large" />
                <p>@Texts["Web.ScreenUnavailable"]</p>
            </div>
            break;

        case ScreenDecision.NotFound:
            <div class="card card-refused" data-state="not-found" role="alert">
                <p>@Texts["Web.ScreenNotFound"]</p>
                <a href="">@Texts["Web.BackHome"]</a>
            </div>
            break;

        default:
            <div class="card card-refused" data-state="refused" role="alert">
                <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Ban" Class="icon-large" />
                <p>@_refusal</p>
                <a href="">@Texts["Web.BackHome"]</a>
            </div>
            break;
    }
</div>

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    /// <summary>« Nouvelle demande pour ce patient »: the order screen with this patient chosen.</summary>
    [SupplyParameterFromQuery(Name = "patient")] public Guid? Patient { get; set; }

    /// <summary>
    /// A file opened from a patient's history or a registration: the file screen on it; the entry
    /// screen opened on a file, as the workstation's InitialOrderId.
    /// </summary>
    [SupplyParameterFromQuery(Name = "dossier")] public Guid? Dossier { get; set; }

    /// <summary>
    /// « Facturation » or « Comptes rendus » opened from a file: searched on its number, as the
    /// workstation's file opens them on it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "recherche")] public string? Recherche { get; set; }

    /// <summary>« Paramètres » opened on a tab: the licence banner's link opens it on the licence's, as the workstation's.</summary>
    [SupplyParameterFromQuery(Name = "onglet")] public string? Onglet { get; set; }

    private ScreenDecision _decision = ScreenDecision.NotFound;
    private MarocLIS.Application.Navigation.MenuEntry? _entry;
    private string? _refusal;
    private string? _decidedFor;

    private string Title => _decision == ScreenDecision.Open && _entry is not null
        ? Texts[_entry.LabelKey]
        : Texts["Web.ScreenRefusedTitle"];

    protected override async Task OnParametersSetAsync()
    {
        if (_decidedFor == Key) return;
        _decidedFor = Key;

        (_decision, _entry) = ScreenAccess.Decide(Key, Context.User, Licence.Current);
        _refusal = null;

        switch (_decision)
        {
            case ScreenDecision.NoPermission:
                // The guard refuses as it refuses any operation, and records the refusal.
                var denied = Guard.RequireAny([.. _entry!.RequiredPermissions]);
                _refusal = Texts.Describe(denied.Errors);
                break;

            case ScreenDecision.NotLicensed:
                var module = LicenceNavigation.ModuleOfEntry[_entry!.Key];
                var refused = Licence.RequireModule(module);
                _refusal = Texts.Describe(refused.Errors);
                await Auditor.LogAsync(SecurityEventKind.AuthorizationDenied, false,
                                       failureReasonKey: refused.FirstError.ResourceKey,
                                       details: $"Web screen {_entry.Key}: module {module} not licensed");
                break;
        }
    }
}
