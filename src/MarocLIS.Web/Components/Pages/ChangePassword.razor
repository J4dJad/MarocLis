@page "/mot-de-passe"
@attribute [ExcludeFromInteractiveRouting]
@layout PlainLayout
@using MarocLIS.Application.Abstractions
@using MarocLIS.Infrastructure.Security
@inject WebTexts Texts
@inject SessionContext Context
@inject IAuthenticationService Authentication
@inject PasswordPolicy Policy
@inject RequestSession Request
@inject WebSessionStore Store
@inject NavigationManager Navigation

@*
    The password change, as the Windows ChangePasswordForm: mandatory after a reset or an expiry
    (the core says so at sign-in) and then nothing else opens until it is done; voluntary otherwise.
    The policy is stated before the operator types, not as a rejection afterwards.
*@
<PageTitle>MarocLIS — @Texts["Action.ChangePassword"]</PageTitle>

<h1 class="form-title">@Texts["Action.ChangePassword"]</h1>

@if (Mandatory)
{
    <p class="message is-warning" role="status" data-state="mandatory">
        <strong>@Texts["Login.PasswordExpiredTitle"]</strong><br />@Texts["Login.PasswordExpiredMessage"]
    </p>
}
else
{
    <p class="form-lead">@Texts["AdminDialog.ChangePasswordForm"]</p>
}

<EditForm Model="Input" FormName="mot-de-passe" OnSubmit="SaveAsync" method="post" class="form" autocomplete="off">
    <label class="field">
        <span class="field-label">@Texts["Admin.CurrentPassword"]</span>
        <InputText @bind-Value="Input.Current" type="password" class="input" dir="ltr" autocomplete="current-password" autofocus />
    </label>
    <label class="field">
        <span class="field-label">@Texts["Admin.NewPassword"]</span>
        <InputText @bind-Value="Input.New" type="password" class="input" dir="ltr" autocomplete="new-password" />
    </label>
    <label class="field">
        <span class="field-label">@Texts["Admin.ConfirmPassword"]</span>
        <InputText @bind-Value="Input.Confirm" type="password" class="input" dir="ltr" autocomplete="new-password" />
    </label>

    <p class="form-hint">@Texts.T("Auth_PasswordTooWeak", Policy.MinimumLength)</p>

    @if (_error is not null)
    {
        <p class="message is-critical" role="alert">@_error</p>
    }

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.Save" />@Texts["Action.Save"]
        </button>
        @if (!Mandatory)
        {
            <a class="btn btn-secondary" href="">@Texts["Action.Cancel"]</a>
        }
    </div>
</EditForm>

@if (Mandatory)
{
    @* Declining is not a way in: the session is ended, as the Windows login ends it. *@
    <form method="post" action="@WebPaths.SignOut.TrimStart('/')" class="form-footer">
        <input type="hidden" name="motif" value="Login.PasswordExpiredMessage" />
        <button type="submit" class="btn btn-secondary">
            <Icon Glyph="MarocLIS.Desktop.Infrastructure.Glyph.LogOut" />@Texts["Action.Logout"]
        </button>
    </form>
}

@code {
    [SupplyParameterFromForm(FormName = "mot-de-passe")]
    private PasswordInput Input { get; set; } = default!;

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private bool Mandatory => Context.Session?.PasswordChangeRequired == true;

    private async Task SaveAsync()
    {
        _error = null;

        if (Context.Session is not { } session)
        {
            Navigation.NavigateTo(WebSessionCookie.LoginPath, forceLoad: true);
            return;
        }

        // The checks of the Windows form, in its order: the two entries alike, the policy, then the
        // core — which checks the current password, the history and the policy again.
        if (Input.New != Input.Confirm)
        {
            _error = Texts["Auth_PasswordMismatch"];
            return;
        }

        var strength = Policy.Validate(Input.New ?? string.Empty);
        if (strength.IsFailure)
        {
            _error = Texts.Describe(strength.Errors);
            return;
        }

        var result = await Authentication.ChangePasswordAsync(session.Session.UserId, Input.Current ?? string.Empty,
                                                              Input.New ?? string.Empty);
        if (result.IsFailure)
        {
            _error = Texts.Describe(result.Errors);
            return;
        }

        // The change moved the account's security stamp; the session takes the new one, or its next
        // check would read the operator's own change as a revocation.
        var stamp = Request.SecurityStamp;
        Store.Update(session.Id, s => s with
        {
            Session = s.Session with { SecurityStamp = stamp ?? s.Session.SecurityStamp, MustChangePassword = false },
            PasswordChangeRequired = false,
            LastCheckedAt = DateTimeOffset.Now
        });

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class PasswordInput
    {
        public string? Current { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }
}
