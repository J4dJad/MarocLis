<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarocLIS.Web</RootNamespace>
    <AssemblyName>MarocLIS.Web</AssemblyName>
    <!--
      « MarocLIS Web »: the second interface on the same core as the Windows application — the same
      use cases, rules, rights, licence and catalogues, rendered in a browser by Blazor Server. It
      runs on the laboratory's server and answers the laboratory's local network only (see
      Security/NetworkAccess.cs and the "Web" section of appsettings.json).

      The same core as the workstation. Of MarocLIS.Instruments it registers only what configuring
      the links needs (AddInstrumentConfiguration: the replay and « Tester une trame »), never its
      host: the analysers are driven by one Windows workstation, never by the web server.
    -->
    <!-- The same reason as the workstation (see MarocLIS.Desktop.csproj): the ambient culture is the
         operator's language, and screen text follows it. -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- The barcode of the label PDF on a Linux server (Directory.Packages.props). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarocLIS.Application\MarocLIS.Application.csproj" />
    <ProjectReference Include="..\MarocLIS.Domain\MarocLIS.Domain.csproj" />
    <ProjectReference Include="..\MarocLIS.Infrastructure\MarocLIS.Infrastructure.csproj" />
    <ProjectReference Include="..\MarocLIS.Instruments\MarocLIS.Instruments.csproj" />
    <ProjectReference Include="..\MarocLIS.Localization\MarocLIS.Localization.csproj" />
    <ProjectReference Include="..\MarocLIS.Reporting\MarocLIS.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The icons of the Windows menu: which glyph goes with which entry is the workstation's own
      catalogue, compiled in by link (it holds no WinForms), and the glyphs are the cells of its
      icon sheet (Resources/Icons/icons.png) exported once to wwwroot/icons, one PNG per Glyph name.
      A glyph added to the workstation is exported the same way; a test checks none is missing.
    -->
    <Compile Include="..\MarocLIS.Desktop\Infrastructure\Glyph.cs" Link="Navigation\Glyph.cs" />
    <Compile Include="..\MarocLIS.Desktop\Infrastructure\IconCatalog.cs" Link="Navigation\IconCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MarocLIS.Tests" />
  </ItemGroup>

</Project>
