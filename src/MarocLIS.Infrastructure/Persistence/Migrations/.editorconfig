# Analyzer settings for EF Core migrations.
#
# The migration body, its .Designer.cs and the model snapshot are generated by `dotnet ef` and are
# regenerated wholesale whenever the model changes. Style and micro-performance rules applied to
# them produce warnings nobody can act on — editing the file by hand is undone by the next
# `migrations add` — and 63 of them were enough to bury the warnings that do matter.
#
# Scoped to this directory so it says nothing about hand-written code. Correctness rules are not
# disabled here: only the advisory ones that generated DDL trips.

[*.cs]

# CA1861: prefer static readonly fields over constant array arguments. Every CreateIndex call with
# a composite key passes `new[] { "A", "B" }`, which is exactly the shape this flags, and each one
# runs once per deployment.
dotnet_diagnostic.CA1861.severity = none
