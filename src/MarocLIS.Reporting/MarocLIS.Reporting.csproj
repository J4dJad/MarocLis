<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarocLIS.Reporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarocLIS.Application\MarocLIS.Application.csproj" />
    <ProjectReference Include="..\MarocLIS.Domain\MarocLIS.Domain.csproj" />
    <ProjectReference Include="..\MarocLIS.Localization\MarocLIS.Localization.csproj" />
  </ItemGroup>

  <!--
    The report fonts ship with the code: Amiri (Arabic, a Naskh face with full Arabic glyph
    coverage) and Carlito (Latin, metric-compatible with Calibri), both SIL OFL, licences beside
    them. They are copied to Assets\Fonts next to the executable and into the published Api, so
    no workstation or service account has to install them.
  -->
  <ItemGroup>
    <None Include="Assets\Fonts\**\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
