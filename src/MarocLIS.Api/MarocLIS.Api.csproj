<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarocLIS.Api</RootNamespace>
    <AssemblyName>MarocLIS.Api</AssemblyName>
    <!--
      The server side of « Validation à distance »: the biologist's phone validates through it. It
      listens on the loopback only and is reached through `tailscale serve`, which adds the TLS and
      the identity of the device (see docs/manuel/10-administration.md).
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Serves the phone's Blazor WebAssembly application (UseBlazorFrameworkFiles). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarocLIS.Api.Contracts\MarocLIS.Api.Contracts.csproj" />
    <ProjectReference Include="..\MarocLIS.Application\MarocLIS.Application.csproj" />
    <ProjectReference Include="..\MarocLIS.Domain\MarocLIS.Domain.csproj" />
    <ProjectReference Include="..\MarocLIS.Infrastructure\MarocLIS.Infrastructure.csproj" />
    <ProjectReference Include="..\MarocLIS.Localization\MarocLIS.Localization.csproj" />
    <!--
      The phone's application. Referenced so its files are published with the service and served
      from the same origin as the API: one address for the phone, one certificate (tailscale serve),
      and the session cookie, SameSite=Strict, sent by the browser without any cross-origin set-up.
    -->
    <ProjectReference Include="..\MarocLIS.Mobile\MarocLIS.Mobile.csproj" />
    <ProjectReference Include="..\MarocLIS.Reporting\MarocLIS.Reporting.csproj" />
  </ItemGroup>

</Project>
