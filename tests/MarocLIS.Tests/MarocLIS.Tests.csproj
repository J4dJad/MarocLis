<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>MarocLIS.Tests</RootNamespace>
    <!--
      CA1707 forbids underscores in identifiers. Test names here are deliberately
      Subject_StatesTheExpectedBehaviour, because the runner prints the method name and that is the
      one place a sentence is more useful than a camel-cased phrase. 210 warnings saying so drown
      out the ones worth reading.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarocLIS.Application\MarocLIS.Application.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Domain\MarocLIS.Domain.csproj" />
    <!--
      Infrastructure is referenced so the shipped role definitions can be asserted against what
      actually seeds, rather than against a copy of them restated in the test.
    -->
    <ProjectReference Include="..\..\src\MarocLIS.Infrastructure\MarocLIS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Instruments\MarocLIS.Instruments.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Localization\MarocLIS.Localization.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Reporting\MarocLIS.Reporting.csproj" />
    <!-- The phone's API, started in memory by WebApplicationFactory against the test SQL Server. -->
    <ProjectReference Include="..\..\src\MarocLIS.Api\MarocLIS.Api.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Api.Contracts\MarocLIS.Api.Contracts.csproj" />
    <!-- The phone's application: its components rendered by bUnit, its rules called directly. -->
    <ProjectReference Include="..\..\src\MarocLIS.Mobile\MarocLIS.Mobile.csproj" />
    <!-- The web interface: its rules called directly, its pages rendered by bUnit, its pipeline started in memory. -->
    <ProjectReference Include="..\..\src\MarocLIS.Web\MarocLIS.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The desktop client targets net10.0-windows and cannot be referenced from here. Its few
      WinForms-free helpers are compiled in by link instead, so their conversions are tested.
    -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\EditorValues.cs" Link="Desktop\EditorValues.cs" />
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\TypedEdits.cs" Link="Desktop\TypedEdits.cs" />
    <!-- The message a screen shows for an exception it caught (conflict or unexpected). -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\FailureMessages.cs" Link="Desktop\FailureMessages.cs" />
    <!-- The per-call query scopes the screens and the analyser host read through. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Composition\IsolatedQueries.cs" Link="Desktop\IsolatedQueries.cs" />
    <!-- Captions broken at their spaces only. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\TextWrap.cs" Link="Desktop\TextWrap.cs" />
    <!-- The order of the sign-in, the main window and the sign-out. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\SessionFlow.cs" Link="Desktop\SessionFlow.cs" />
    <!-- The value-axis arithmetic of the hand-drawn charts. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Controls\ChartScale.cs" Link="Desktop\ChartScale.cs" />
    <!-- Where F1 finds the help page of a screen. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\HelpCatalog.cs" Link="Desktop\HelpCatalog.cs" />
    <!-- The colours of the design system, checked against its contrast rules. -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Infrastructure\UiTheme.Palette.cs" Link="Desktop\UiTheme.Palette.cs" />
    <!-- The take-over profiles kept on the workstation (« Reprise de données »). -->
    <Compile Include="..\..\src\MarocLIS.Desktop\Views\DataMigrationProfiles.cs" Link="Desktop\DataMigrationProfiles.cs" />
    <!-- The licence generator's keys, register and drafts: no WinForms in them. -->
    <Compile Include="..\..\tools\MarocLIS.LicenseGenerator\Core\*.cs" Link="Licensing\Generator\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The private half of the development licence key: the tests sign their licences with it. -->
    <EmbeddedResource Include="Licensing\dev-licence-private-key.pem" LogicalName="MarocLIS.Tests.dev-licence-private-key.pem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
