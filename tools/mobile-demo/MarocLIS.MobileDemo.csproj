<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A development tool, not part of the product: it fills a scratch database with the five
    fictitious files the phone's screens are shown and tested against (docs/manuel/03, the
    screenshots in lis-screens/mobile). It is kept out of MarocLIS.sln so a laboratory build never
    ships it: `dotnet run` builds it on demand (see Program.cs).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarocLIS.MobileDemo</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- A console tool prints in French to a developer; the locale rules are the product's concern. -->
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1307;CA1310;CA1311</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MarocLIS.Application\MarocLIS.Application.csproj" />
    <ProjectReference Include="..\..\src\MarocLIS.Infrastructure\MarocLIS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
